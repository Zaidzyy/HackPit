# HackPit Cockpit — engagement-mode SCOPE-LOCK firewall sidecar.
#
# This tiny container OWNS the network namespace that the engagement sandbox SHARES
# (compose `network_mode: "service:engage-firewall"`). It is the ONLY container in the
# engagement pair with NET_ADMIN; the sandbox itself stays cap_drop:ALL + no-new-privileges
# and inherits this netns' egress filter — it cannot alter the rules.
#
# SCOPE-LOCK (replaces the old Wall-A denylist): DEFAULT-DENY egress. At container start the
# entrypoint installs "drop everything except loopback" (fail-closed). On engagement ENTER the
# backend execs `scope_lock.sh apply <resolved-scope>` to allow ONLY the authorized scope; on
# EXIT it resets to deny. The backend re-reads the ruleset (assert_scope_locked) before every
# engagement exec, so a flushed/widened ruleset fails the gate and nothing runs.
FROM debian:stable-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iptables \
        iproute2 \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY scope_lock.sh /usr/local/bin/scope_lock.sh
COPY scope_lock_entrypoint.sh /usr/local/bin/scope_lock_entrypoint.sh
RUN chmod +x /usr/local/bin/scope_lock.sh /usr/local/bin/scope_lock_entrypoint.sh

# Runs as root (NET_ADMIN is needed to program iptables). The sandbox that shares this netns
# runs unprivileged and drops all caps — it cannot touch these rules.
ENTRYPOINT ["/usr/local/bin/scope_lock_entrypoint.sh"]
