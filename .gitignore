# ---- HackPit root .gitignore ----
# This will be a PUBLIC repo: ship CODE ONLY.
# No third-party content, no raw notes, no secrets — ever.

# Knowledge (NEVER commit)
/data/
# Every source drop stays out — clones, notes, PDFs, writeups. Spelled `/sources/*` rather
# than `/sources/` ONLY so the one exception below can be un-ignored; a directory git never
# descends into cannot have a file re-included from it. Subdirectories (sources/repos/...)
# are still ignored wholesale, because their parent is.
/sources/*
# THE ONE EXCEPTION: the clone manifest. It records URL + date + commit SHA + verdict for
# every repo a KB batch was built from — our own prose about third-party repos, never their
# content. Without it, "which commit of which repo produced these entries" is unanswerable
# once the clones are deleted, which is the whole point of deleting them.
!/sources/repos-manifest.md

# Secrets & env
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
*.secret

# LLM provider config — may hold an API key. NEVER commit.
llm_config.json
backend/llm_config.json

# Operator identity (real name / OSID / email). This repo is PUBLIC. NEVER commit.
operator.json
backend/operator.json
!backend/operator.example.json

# Local engagement sessions store (SQLite). NEVER commit.
sessions.db
backend/sessions.db
*.db-wal
*.db-shm

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python (backend / pipeline) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
