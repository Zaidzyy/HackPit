# HackPit Cockpit — Kali sandbox image.
#
# ONE image, three containers (see docker-compose.yml). The image is identical for the
# lab, `:kali` and engagement sandboxes — what differs is the RUNTIME posture each
# compose service applies (network, user, capabilities). Do not fork this file per
# sandbox; change the compose service instead.
#
# Tools are baked in at BUILD time (the build has internet). At RUNTIME the *lab*
# sandbox joins only the `internal: true` network, so it has no egress — it can never
# apt-install or phone home once running. That is the point, and it is why every tool
# and every wordlist has to be present in the image rather than fetched on demand.
#
# Base: kali-rolling + `kali-linux-headless`. The previous debian:stable-slim base shipped
# 7 tools while backend/arsenal/tools.json catalogued 73 — the planner routinely proposed
# commands (gobuster, nikto, impacket, netexec, …) that did not exist in the sandbox.
# Everything below exists to close that gap:
#   * kali-linux-headless      — the standard Kali CLI toolset
#   * explicit tool layers     — the specific tools the capability assessment found missing,
#                                grouped by theme so a bad package name fails in an obvious
#                                layer and the expensive layers above it stay cached
#   * seclists + wordlists     — real content discovery (the old image had a 15-word list)
#   * nuclei-templates         — baked; the lab sandbox has no egress so it can NEVER
#                                `-update-templates` at runtime
#
# NOT here, on purpose: PowerShell/.NET tooling (PowerView, Rubeus, Mimikatz, SharpHound,
# winPEAS). They cannot run on a Linux container. See D9 in docs/ASSESSMENT-2026-07-26.md.
#
# Size/time: this is a ~8-10 GB image and a cold build takes a while (kali-linux-headless
# and seclists are most of it). That is the agreed trade for a sandbox that can actually
# run what the arsenal advertises.
FROM kalilinux/kali-rolling

# Kali's apt prompts on a few packages (wireshark, kismet, sslh); never let a build block.
ENV DEBIAN_FRONTEND=noninteractive

# --- 1. The Kali toolset ------------------------------------------------------
# Slowest and most stable layer, so it goes first and stays cached across edits below.
# Recommends are deliberately NOT disabled here: several kali-tools-* metapackages pull
# their tools via Recommends, and stripping them would silently shrink the toolset.
RUN apt-get update \
    && apt-get install -y kali-linux-headless \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Shell + fetch + build basics -----------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl wget git \
        unzip p7zip-full \
        jq less vim tmux screen rlwrap \
        iproute2 iptables iputils-ping dnsutils \
        openssh-client \
        python3-pip python3-venv pipx \
    && rm -rf /var/lib/apt/lists/*

# --- 3. Web / recon ----------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nmap sqlmap nikto whatweb wafw00f wpscan \
        gobuster feroxbuster dirsearch wfuzz \
        subfinder httpx-toolkit amass \
        dnsrecon dnsenum fierce \
        sslscan testssl.sh \
        assetfinder dnsx naabu hakrawler arjun paramspider \
    && rm -rf /var/lib/apt/lists/*

# --- 3b. Web application scanner (ZAP) ---------------------------------------
# OWASP ZAP + a headless JRE. Its own layer because it is large and stable: an edit to the
# tool layers around it must not force it to rebuild.
#
# Add-ons are baked at build time on purpose. The lab sandbox joins an `internal: true`
# network and has NO egress, so it can never fetch one at runtime — the same reason
# nuclei-templates is baked in layer 9 rather than `-update-templates`d.
#
# THE NAMES HERE ARE MEASURED, NOT ASSUMED, and the first version of this layer got them
# wrong. Upstream documents packaged scan scripts (`zap-baseline.py`, `zap-full-scan.py`);
# those exist ONLY inside OWASP's own Docker image and Kali ships NEITHER. `dpkg -L zaproxy`
# on 2.17.0-0kali1 gives exactly three programs:
#     /usr/bin/zaproxy   /usr/bin/owasp-zap   /usr/share/zaproxy/zap.sh   (zap.sh NOT on PATH)
# backend/state/parsers.py keys STDOUT_PARSERS on `zaproxy` / `owasp-zap` because of that. A
# key that can never match ingests nothing, run after run, with a green suite — the build #9
# gap, where a live DCSync dumped krbtgt and ingested none of it.
#
# The smoke test is TWO checks because they fail separately, and `command -v` alone is not a
# smoke test (build #4's lesson): `-version` is what proves the JVM actually starts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        zaproxy default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && command -v zaproxy \
    && zaproxy -cmd -version

# --- 3b-bis. *** THE GraphQL ADD-ON IS A PINNED BUILD INPUT (build #21 item 1) *** ----
#
# WHY THIS LAYER EXISTS, AND IT IS NOT HOUSEKEEPING. Build #20's GraphQL go/no-go -- 56 checks,
# the measurement that decided how two whole items were built -- ran against
# `graphql-alpha-0.33.0`. This image shipped **0.29.0**. The 0.33.0 was a RUNTIME AUTO-UPDATE
# living in one long-lived container's writable layer at `/root/.ZAP/plugin/`, and ZAP prefers
# `$HOME/.ZAP/plugin` to its own install tree. So the proof measured an implementation the image
# does not build, the two disagreed for a day, and NOTHING SAID SO. Recreating that container
# would have reverted the scanner's GraphQL engine underneath a proof already written down as
# passing.
#
# *** THE DRIFT WAS 33 ADD-ONS WIDE, NOT ONE. *** Measured before this layer was written: every
# file in that container's `/root/.ZAP/plugin/` carried the same timestamp -- ZAP had updated
# its ENTIRE installed set in one pass, of which `graphql` was simply the one under test. The
# add-on version is therefore a build input here, exactly like the chromedriver and chromium
# majors compared in the layer below, and exactly like nuclei-templates being baked rather than
# `-update-templates`d: this image's standing position is that what the tools run is decided at
# build time, not by whatever the marketplace held the first time a container happened to boot.
#
# WHAT THAT COSTS, STATED RATHER THAN GLOSSED: add-on and scan-rule updates now arrive by
# REBUILDING, not by a daemon restart. Nothing is refused -- an operator can still
# `zaproxy -addoninstall`, still update from ZAP's own UI, and still start a daemon without the
# flag. The default simply stopped being "silently whatever is newest".
#
# *** THE ASSERTION IS `installedAddons`, NOT `ls`. *** A layer that installs a file proves
# nothing about which file gets LOADED -- an `ls` of the system plugin dir would have passed
# happily inside the very container where the drift lived, because the 0.29.0 file really was
# there and ZAP was simply ignoring it. `zap-addon-check.py` starts a daemon and reads back the
# `file` field ZAP reports for the add-on: the absolute path it resolved. That is the only
# question whose answer a shadowing directory cannot change. It leaves no ZAP home behind, so
# no API key, no `api.disablekey` and no `dayLastChecked` is baked into the image.
#
# *** AND THE ASSERTION CAUGHT A BROKEN PIN ON ITS VERY FIRST RUN: AN ADD-ON VERSION IS A
#     DEPENDENCY CLOSURE, NOT A FILE. *** Installing `graphql-alpha-0.33.0.zap` here and
# deleting 0.29.0 produced a ZAP with NO GraphQL add-on loaded at all -- not an error, not a
# warning, not a line in the log, simply absent from `installedAddons`. 0.33.0's manifest
# requires `commonlib >= 1.40.0 & < 2.0.0`; this image shipped **1.39.0**, so ZAP declined it in
# silence. The drifted container's 0.33.0 had only ever worked because the same auto-update pass
# had also lifted commonlib to 1.43.0 -- which is the concrete reason the drift is 33 add-ons
# wide rather than one, and why COMMONLIB IS PINNED HERE TOO. `commonlib` 1.43.0 declares no
# dependencies of its own, so the closure is exactly these two, measured rather than assumed.
#
# 1.43.0 specifically, not merely ">= 1.40.0": it is the version build #20's 56/0 proof was
# actually measured against, so the image now REPRODUCES the surface that proof recorded. That
# is what makes re-running it a regression test instead of a fresh measurement.
#
# An `ls`-based check would have shipped that image with a green build and a GraphQL scanner
# that had silently ceased to exist.
ARG ZAP_GRAPHQL_ADDON_VERSION=0.33.0
ARG ZAP_COMMONLIB_ADDON_VERSION=1.43.0
COPY zap-addon-check.py /usr/local/bin/zap-addon-check
RUN set -eu; \
    chmod 0755 /usr/local/bin/zap-addon-check; \
    P=/usr/share/zaproxy/plugin; \
    fetch() { \
        echo "pinning $1 $3"; \
        curl -fsSL --retry 3 --retry-delay 2 -o "$P/$1-$2-$3.zap.part" \
            "https://github.com/zaproxy/zap-extensions/releases/download/$1-v$3/$1-$2-$3.zap"; \
        mv "$P/$1-$2-$3.zap.part" "$P/$1-$2-$3.zap"; \
        for old in "$P"/"$1"-*.zap; do \
            [ "$old" = "$P/$1-$2-$3.zap" ] || { echo "  removing superseded $old"; rm -f "$old"; }; \
        done; \
    }; \
    fetch graphql alpha "${ZAP_GRAPHQL_ADDON_VERSION}"; \
    fetch commonlib release "${ZAP_COMMONLIB_ADDON_VERSION}"; \
    zap-addon-check --start \
        --pin "graphql:alpha:${ZAP_GRAPHQL_ADDON_VERSION}" \
        --pin "commonlib:release:${ZAP_COMMONLIB_ADDON_VERSION}"; \
    rm -rf /root/.ZAP

# --- 3b. A WEBDRIVER, so ZAP's AJAX spider can drive a real browser (build #15) ------
#
# WHY A BROWSER IS THE WHOLE FEATURE. A passive sweep of a live bug bounty program returned
# nothing at all from every host: HTTP/2 answered with an instant stream reset, HTTP/1.1 with a
# total timeout. Two DIFFERENT failure modes on two protocols is an edge actively refusing the
# client, not a protocol quirk — nine of eleven assets sit behind Akamai Bot Manager. HackPit's
# egress was fine; it reached Akamai and Akamai said no. A real browser is what passes: correct
# TLS fingerprint, real headers, JS execution.
#
# *** THE PACKAGE NAME WAS UNVERIFIED WHEN THIS WAS WRITTEN, AND THAT IS WHY IT IS SHAPED
#     LIKE THIS. *** The running container has ZERO apt list files, so `apt-cache` inside it
#     cannot see any uninstalled package and the obvious check proves nothing. This is exactly
#     how build #14 part 1 was written against `zap-baseline.py`, which Kali does not ship —
#     caught only by the image build. So: install it, then PROVE it, and let the layer fail
#     loudly here rather than at crawl time inside ZAP's log.
#
# Chromium is already present (150.0.7871.124, pulled in by the kali metapackage) and Firefox is
# NOT — while ZAP's own default browser id is `firefox-headless`. That mismatch is the trap: it
# fails at CRAWL time, not at set time, because `setOptionBrowserId` accepts anything (measured:
# it returned {"Result":"OK"} for `not-a-browser`). cockpit/proxy.SPIDER_BROWSER_ID is
# `chrome-headless` for that reason and reads the value back rather than trusting the OK.
#
# *** TWO DEFECTS ONLY A REAL CRAWL FOUND, AND THE SECOND WAS HIDDEN BY THE FIRST. ***
# The first version of this layer installed the driver, proved it runs, proved a browser exists,
# and was still completely broken. Both failures produced the same symptom — the AJAX spider
# returning `{"Result":"OK"}` and then finding zero URLs — and neither is visible without
# actually crawling something:
#
#   1. CHROMIUM REFUSES TO RUN AS ROOT WITHOUT `--no-sandbox`. The ENGAGE sandbox runs
#      `user: root` (docker-compose.yml), so every browser Crawljax launched died instantly:
#        "Running as root without --no-sandbox is not supported"
#      ZAP's Selenium addon exposes no API for adding Chrome arguments in this version, so the
#      flag goes in via `/etc/chromium.d/`, which Debian's own launcher sources (it already
#      ships a `dev-shm` file there). It is the packaged extension point, not a hack.
#
#      WHAT --no-sandbox COSTS, STATED RATHER THAN GLOSSED: it turns off Chromium's internal
#      process sandbox, and this browser visits TARGET-CONTROLLED content. The boundary that
#      actually holds here is the container — unprivileged-or-root inside a cap-dropped,
#      no-new-privileges sandbox on a disposable image — not Chromium's own. It is not a
#      trade so much as an acknowledgement that as root the alternative is a browser that
#      does not start. `--disable-dev-shm-usage` is the companion fix for Docker's 64MB
#      /dev/shm, which crashes Chromium on any real page.
#
#   2. ZAP SHIPS ITS OWN CHROMEDRIVER AND PREFERS IT TO THIS PACKAGE. The `webdriverlinux`
#      add-on bundles a driver built for Chrome 151; Kali ships Chromium 150. So installing
#      `chromium-driver` was necessary and NOT sufficient — the crawl failed with
#        "This version of ChromeDriver only supports Chrome version 151"
#      cockpit/proxy.py therefore passes `-config selenium.chromeDriver=/usr/bin/chromedriver`
#      on every daemon start, which is also why the MAJOR VERSIONS ARE COMPARED BELOW. Proving
#      the driver runs proves nothing about whether it can drive the browser that is here —
#      "an exit code is not a result", one level deeper than part 1 phrased it.
#
#   3. CHROMIUM PHONED GOOGLE THROUGH THE PROXY. Found by reading the live run's capture, not
#      by a test: a crawl aimed at a local two-page lab site also produced requests to
#      www.google.com, gstatic.com and play.google.com — the variations seed and search
#      preconnect, egressing through the ZAP proxy because the engage sandbox has full egress.
#      Harmless in the lab and WRONG on an engagement: traffic nobody asked for, leaving the
#      operator's IP, landing in the capture that a report is written from. The browser must
#      talk to the target and nothing else. (`--no-default-browser-check` is also set by
#      Debian's own /etc/chromium.d/default-flags; it is repeated here so this one file states
#      the whole intent rather than depending on a packaging file we do not control.)
#
#   4. THE CRAWL BROWSER IS HEADED NOW, AND THAT NEEDS A DISPLAY (build #17). Build #15 shipped
#      `chrome-headless` and the crawl was refused outright by the very assets the feature
#      exists for. The measured discriminator is NOT the `HeadlessChrome` token: headless
#      Chromium sends NO `Sec-CH-UA` Client Hints at all, and `--user-agent` does not add them,
#      so a spoofed UA fails exactly as a stock one does (both 504; headed gets 31x 200). The
#      honest fix is the only one that works — use a real browser — and a real browser draws
#      somewhere. Hence `xvfb`, and `DISPLAY` exported from the drop-in below so any Chromium
#      the Debian launcher starts finds the display whatever spawned it, without threading an
#      environment variable through ZAP, Selenium and Crawljax.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium-driver xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && printf '%s %s\n%s\n' \
              'CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-dev-shm-usage' \
              '--disable-background-networking --no-first-run --no-default-browser-check"' \
              'export DISPLAY="${DISPLAY:-:99}"' \
         > /etc/chromium.d/hackpit-container \
    && command -v Xvfb \
    && command -v chromedriver \
    && command -v chromium \
    && DRV="$(chromedriver --version | sed -E 's/^ChromeDriver ([0-9]+)\..*/\1/')" \
    && BRW="$(chromium --version | sed -E 's/^Chromium ([0-9]+)\..*/\1/')" \
    && echo "chromedriver major=$DRV  chromium major=$BRW" \
    && [ -n "$DRV" ] && [ -n "$BRW" ] \
    && { [ "$DRV" = "$BRW" ] || { \
           echo "FATAL: chromedriver $DRV cannot drive chromium $BRW. Selenium refuses the" \
                "session with 'only supports Chrome version $DRV' and the AJAX spider returns" \
                "OK while crawling nothing."; exit 1; }; } \
    && chromium --headless=new --dump-dom about:blank >/dev/null 2>&1

# --- 4. Network / Active Directory (from Linux) ------------------------------
# The AD graph + AD orchestration modules generate commands from exactly this set;
# without these packages every proposed AD step failed "executable not found".
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        smbclient smbmap enum4linux enum4linux-ng \
        python3-impacket impacket-scripts \
        netexec evil-winrm \
        bloodhound.py certipy-ad bloodyad \
        krb5-user ldap-utils \
        responder mitm6 \
        masscan arp-scan nbtscan onesixtyone snmp tcpdump \
    && rm -rf /var/lib/apt/lists/*

# --- 5. Exploitation / cracking ----------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        metasploit-framework exploitdb \
        hydra john hashcat \
        gdb trivy \
    && rm -rf /var/lib/apt/lists/*

# --- 6. Pivoting / tunnelling / VPN ------------------------------------------
# openvpn is here for HTB/PG/client VPNs. It also needs NET_ADMIN + /dev/net/tun, which
# only the ENGAGEMENT sandbox gets (docker-compose.yml). The lab sandbox has neither and
# must not — its whole value is that it cannot reach anything but the lab target.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chisel ligolo-ng proxychains4 sshuttle \
        socat ncat netcat-traditional \
        openvpn \
    && rm -rf /var/lib/apt/lists/*

# --- 7. Wordlists -------------------------------------------------------------
# seclists lands in /usr/share/seclists; `wordlists` provides /usr/share/wordlists
# (including rockyou, which it ships gzipped — decompress it at build so the no-egress
# sandbox can use it directly).
RUN apt-get update \
    && apt-get install -y --no-install-recommends seclists wordlists \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /usr/share/wordlists/rockyou.txt.gz ]; then \
           gunzip -f /usr/share/wordlists/rockyou.txt.gz; \
       fi \
    && test -d /usr/share/seclists

# --- 8. Pinned binaries -------------------------------------------------------
# Two reasons a tool lands here rather than in an apt layer above:
#   1. ffuf / nuclei — pinned deliberately rather than tracking kali-rolling; nuclei in
#      particular has to stay version-matched to the template set baked in layer 9.
#   2. katana / kerbrute / waybackurls — kali-rolling has NO package for these (verified
#      against the repo, not assumed), so upstream release binaries are the only option.
# /usr/local/bin precedes /usr/bin on PATH, so these win over any apt-installed copy.
# Every fetch ends in a `-version`/`-h` smoke test so a bad URL fails the build loudly
# instead of shipping an image that is missing a tool the arsenal advertises.
ARG FFUF_VERSION=2.1.0
RUN curl -fsSL "https://github.com/ffuf/ffuf/releases/download/v${FFUF_VERSION}/ffuf_${FFUF_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/ffuf.tgz \
    && tar -xzf /tmp/ffuf.tgz -C /usr/local/bin ffuf \
    && rm /tmp/ffuf.tgz \
    && /usr/local/bin/ffuf -V

ARG NUCLEI_VERSION=3.3.9
RUN curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" \
        -o /tmp/nuclei.zip \
    && unzip -o /tmp/nuclei.zip nuclei -d /usr/local/bin \
    && rm /tmp/nuclei.zip \
    && /usr/local/bin/nuclei -version

# katana — crawler. Not in kali-rolling.
ARG KATANA_VERSION=1.1.0
RUN curl -fsSL "https://github.com/projectdiscovery/katana/releases/download/v${KATANA_VERSION}/katana_${KATANA_VERSION}_linux_amd64.zip" \
        -o /tmp/katana.zip \
    && unzip -o /tmp/katana.zip katana -d /usr/local/bin \
    && rm /tmp/katana.zip \
    && /usr/local/bin/katana -version

# kerbrute — Kerberos user/password enumeration. Not in kali-rolling.
ARG KERBRUTE_VERSION=1.0.3
RUN curl -fsSL "https://github.com/ropnop/kerbrute/releases/download/v${KERBRUTE_VERSION}/kerbrute_linux_amd64" \
        -o /usr/local/bin/kerbrute \
    && chmod +x /usr/local/bin/kerbrute \
    && /usr/local/bin/kerbrute --help > /dev/null

# waybackurls — archived-URL discovery for bug bounty. Not in kali-rolling.
ARG WAYBACKURLS_VERSION=0.1.0
RUN curl -fsSL "https://github.com/tomnomnom/waybackurls/releases/download/v${WAYBACKURLS_VERSION}/waybackurls-linux-amd64-${WAYBACKURLS_VERSION}.tgz" \
        -o /tmp/waybackurls.tgz \
    && tar -xzf /tmp/waybackurls.tgz -C /usr/local/bin waybackurls \
    && rm /tmp/waybackurls.tgz \
    && test -x /usr/local/bin/waybackurls

# dalfox — XSS scanner. Not in kali-rolling.
ARG DALFOX_VERSION=2.9.2
RUN curl -fsSL "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox_${DALFOX_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/dalfox.tgz \
    && tar -xzf /tmp/dalfox.tgz -C /usr/local/bin dalfox \
    && rm /tmp/dalfox.tgz \
    && /usr/local/bin/dalfox version

# gau (getallurls) — archived-URL discovery. Not in kali-rolling.
ARG GAU_VERSION=2.2.4
RUN curl -fsSL "https://github.com/lc/gau/releases/download/v${GAU_VERSION}/gau_${GAU_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/gau.tgz \
    && tar -xzf /tmp/gau.tgz -C /usr/local/bin gau \
    && rm /tmp/gau.tgz \
    && test -x /usr/local/bin/gau

# rustscan — fast port sweep that hands off to nmap. Not in kali-rolling. Upstream ships
# the linux build as a .tar.gz INSIDE a .zip, hence the two-step extract.
ARG RUSTSCAN_VERSION=2.4.1
RUN curl -fsSL "https://github.com/bee-san/RustScan/releases/download/${RUSTSCAN_VERSION}/x86_64-linux-rustscan.tar.gz.zip" \
        -o /tmp/rustscan.zip \
    && unzip -o -j /tmp/rustscan.zip -d /tmp/rustscan \
    && tar -xzf "$(find /tmp/rustscan -name '*.tar.gz' | head -1)" -C /tmp/rustscan \
    && install -m 0755 "$(find /tmp/rustscan -type f -name 'rustscan' | head -1)" /usr/local/bin/rustscan \
    && rm -rf /tmp/rustscan /tmp/rustscan.zip \
    && /usr/local/bin/rustscan --version

# jwt_tool — JWT analysis/forging. A Python script, not a binary and not packaged; it gets
# its own venv so its pins never collide with Kali's system Python (which is PEP-668
# externally-managed), plus a wrapper so `jwt_tool` resolves on PATH like any other tool.
ARG JWT_TOOL_VERSION=2.2.6
RUN curl -fsSL "https://github.com/ticarpi/jwt_tool/archive/refs/tags/v${JWT_TOOL_VERSION}.tar.gz" \
        -o /tmp/jwt_tool.tgz \
    && mkdir -p /opt/jwt_tool \
    && tar -xzf /tmp/jwt_tool.tgz -C /opt/jwt_tool --strip-components=1 \
    && rm /tmp/jwt_tool.tgz \
    && python3 -m venv /opt/jwt_tool/venv \
    && /opt/jwt_tool/venv/bin/pip install --no-cache-dir -q -r /opt/jwt_tool/requirements.txt \
    && printf '#!/bin/sh\nexec /opt/jwt_tool/venv/bin/python /opt/jwt_tool/jwt_tool.py "$@"\n' \
        > /usr/local/bin/jwt_tool \
    && chmod 0755 /usr/local/bin/jwt_tool \
    && chmod -R a+rX /opt/jwt_tool \
    && /usr/local/bin/jwt_tool --help > /dev/null

# --- 9. nuclei templates (baked — the sandbox can never fetch them) ----------
# Cloned to a shared path, then symlinked into BOTH possible home directories, because
# nuclei looks in $HOME/.local/nuclei-templates and the engagement sandbox runs as root
# while the lab/:kali sandboxes run as `sandbox`. Symlinks rather than config files so
# this does not depend on nuclei's config-key naming staying stable.
# Pin NUCLEI_TEMPLATES_REF to a tag for a fully reproducible build.
ARG NUCLEI_TEMPLATES_REF=main
RUN git clone --depth 1 --branch "${NUCLEI_TEMPLATES_REF}" \
        https://github.com/projectdiscovery/nuclei-templates.git \
        /usr/share/nuclei-templates \
    && rm -rf /usr/share/nuclei-templates/.git \
    && test "$(find /usr/share/nuclei-templates -name '*.yaml' | head -1001 | wc -l)" -gt 1000

# Suppress nuclei's startup update check — it has no egress at runtime and the warning
# only adds noise to every transcript.
ENV DISABLE_UPDATE_CHECK=true

# --- 9b. Catalog-name aliases -------------------------------------------------
# Three tools install under a binary name that differs from the name
# backend/arsenal/tools.json calls them by. Without these, the startup reconciliation
# check (D7) reports installed tools as missing and the planner's prompt block silently
# loses them — the exact failure mode this whole image rebuild exists to end.
#   arsenal name  ->  Kali binary
#   testssl.sh        testssl
#   certipy           certipy-ad
#   bloodyAD          bloodyad
# The `test -x` guards mean a future Kali rename breaks the BUILD rather than quietly
# reintroducing a dangling alias.
RUN set -e; \
    for pair in "testssl.sh:testssl" "certipy:certipy-ad" "bloodyAD:bloodyad"; do \
        alias_name="${pair%%:*}"; real="${pair#*:}"; \
        target="$(command -v "$real")"; \
        test -x "$target"; \
        ln -sfn "$target" "/usr/local/bin/${alias_name}"; \
    done; \
    for n in testssl.sh certipy bloodyAD; do command -v "$n" >/dev/null; done

# --- 9c. reconFTW recon tools — apt (kali packages) --------------------------
# massdns (the resolver engine puredns drives) and commix are both in kali-rolling.
# Placed below the expensive kali/seclists/nuclei layers so editing the recon set never
# invalidates their cache.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        massdns commix \
    && rm -rf /var/lib/apt/lists/* \
    && command -v massdns && command -v commix >/dev/null

# --- 9d. reconFTW recon tools — Go (built with a temporary toolchain) ---------
# No kali package for these (checked against reconFTW's own install list). Rather than guess
# ~18 release-asset URLs, build them with `go install` using the exact module paths from
# reconFTW's install.sh, into /usr/local/bin. The Go toolchain + build cache are removed at
# the end of the layer so only the binaries ship. @latest matches reconFTW; pin a tag for a
# fully reproducible build. Every binary is smoke-checked so a bad module fails the build.
ARG GO_VERSION=1.23.4
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz \
    && export PATH="/usr/local/go/bin:$PATH" GOBIN=/usr/local/bin GOFLAGS=-buildvcs=false \
    && for mod in \
        github.com/tomnomnom/gf@latest \
        github.com/tomnomnom/qsreplace@latest \
        github.com/tomnomnom/unfurl@latest \
        github.com/lc/subjs@latest \
        github.com/BishopFox/jsluice/cmd/jsluice@latest \
        github.com/dwisiswant0/crlfuzz/cmd/crlfuzz@latest \
        github.com/d3mondev/puredns/v2@latest \
        github.com/Josue87/gotator@latest \
        github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest \
        github.com/projectdiscovery/asnmap/cmd/asnmap@latest \
        github.com/projectdiscovery/tlsx/cmd/tlsx@latest \
        github.com/gwen001/github-subdomains@latest \
        github.com/gwen001/gitlab-subdomains@latest \
        github.com/damit5/gitdorks_go@latest \
        github.com/sa7mon/s3scanner@latest \
        github.com/edoardottt/csprecon/cmd/csprecon@latest \
        github.com/devploit/nomore403@latest \
    ; do echo ">> go install $mod" && go install "$mod"; done \
    # getjs overlaps subjs and its module path is less stable — best-effort, never fails the build.
    && { go install github.com/003random/getJS/v2@latest \
         && ln -sfn "$(command -v getJS)" /usr/local/bin/getjs; } || echo "getjs: optional, skipped" \
    && rm -rf /usr/local/go /root/go /root/.cache/go-build \
    && for b in gf qsreplace unfurl subjs jsluice crlfuzz puredns gotator mapcidr asnmap tlsx \
                github-subdomains gitlab-subdomains gitdorks_go s3scanner csprecon nomore403; do \
           command -v "$b" >/dev/null || { echo "MISSING go tool: $b"; exit 1; }; \
       done

# --- 9d-bis. trufflehog (release binary, not `go install`) -------------------
# trufflehog's recent releases require Go >= 1.25, a moving target that broke the pinned Go
# toolchain above. Its official installer fetches the prebuilt linux/amd64 binary instead —
# no toolchain, no version treadmill. Smoke-tested so a bad fetch still fails the build.
RUN curl -fsSL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh \
        | sh -s -- -b /usr/local/bin \
    && /usr/local/bin/trufflehog --version 2>&1 | head -1 \
    && command -v trufflehog >/dev/null

# --- 9e. reconFTW recon tools — Python (venv + PATH wrapper) ------------------
# No kali package; each gets an isolated venv (Kali's system Python is PEP-668 managed) and a
# PATH wrapper, the jwt_tool idiom. subwiz is deliberately NOT here: it downloads an ML model
# at runtime, so it is catalogued but runs only in the egress-enabled sandboxes
# (engagement / :kali), never the airgapped lab — gotator/regulator cover permutations offline.
RUN set -eu; \
    mkvenv() { git clone --depth 1 "https://github.com/$1" "/opt/$2"; \
               python3 -m venv "/opt/$2/venv"; \
               if [ -f "/opt/$2/requirements.txt" ]; then \
                   "/opt/$2/venv/bin/pip" install --no-cache-dir -q -r "/opt/$2/requirements.txt"; fi; }; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    mkvenv cramppet/regulator regulator; \
        wrap regulator "/opt/regulator/venv/bin/python /opt/regulator/main.py"; \
    mkvenv vladko312/SSTImap SSTImap; \
        wrap SSTImap "/opt/SSTImap/venv/bin/python /opt/SSTImap/sstimap.py"; \
    mkvenv six2dez/dorks_hunter dorks_hunter; \
        "/opt/dorks_hunter/venv/bin/pip" install --no-cache-dir -q xnldorker || true; \
        wrap dorks_hunter "/opt/dorks_hunter/venv/bin/python /opt/dorks_hunter/dorks_hunter.py"; \
    mkvenv initstring/cloud_enum cloud_enum; \
        wrap cloud_enum "/opt/cloud_enum/venv/bin/python /opt/cloud_enum/cloud_enum.py"; \
    git clone --depth 1 https://github.com/vortexau/dnsvalidator /opt/dnsvalidator; \
        python3 -m venv /opt/dnsvalidator/venv; \
        /opt/dnsvalidator/venv/bin/pip install --no-cache-dir -q /opt/dnsvalidator; \
        wrap dnsvalidator "/opt/dnsvalidator/venv/bin/dnsvalidator"; \
    git clone --depth 1 https://github.com/Arcanum-Sec/msftrecon /opt/msftrecon; \
        python3 -m venv /opt/msftrecon/venv; \
        /opt/msftrecon/venv/bin/pip install --no-cache-dir -q -e /opt/msftrecon; \
        wrap msftrecon "/opt/msftrecon/venv/bin/msftrecon"; \
    chmod -R a+rX /opt/regulator /opt/SSTImap /opt/dorks_hunter /opt/cloud_enum /opt/dnsvalidator /opt/msftrecon; \
    for b in regulator SSTImap dorks_hunter cloud_enum dnsvalidator msftrecon; do command -v "$b" >/dev/null; done

# --- 9e-ter. cloud IAM privilege-escalation tooling (the :cloud graph) ---------
# The tools the cloud IAM graph enumerates with, plus the AWS CLI the abuse commands run through.
# Each Python tool gets its OWN venv (their pins conflict — prowler pins boto3/pydantic hard) and a
# PATH wrapper, the mkvenv idiom above. THE BINARY NAME IS VERIFIED, not assumed (kali-sandbox
# image trap): the `scoutsuite` package ships `scout`, so that is what the catalog template calls;
# `pacu`/`prowler`/`aws` keep their names. cloudfox has no PyPI package — it ships a release binary
# (the Go toolchain built at 9d is already gone), fetched like trufflehog. Every binary is
# smoke-checked so a bad install fails the build, and docker/proof/cloud_install_proof.sh re-checks
# that every name the catalog templates hardcode resolves inside the running container.
RUN set -eu; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    python3 -m venv /opt/awscli && /opt/awscli/bin/pip install --no-cache-dir -q awscli \
        && wrap aws "/opt/awscli/bin/aws"; \
    python3 -m venv /opt/scoutsuite && /opt/scoutsuite/bin/pip install --no-cache-dir -q scoutsuite \
        && wrap scout "/opt/scoutsuite/bin/scout"; \
    python3 -m venv /opt/prowler && /opt/prowler/bin/pip install --no-cache-dir -q prowler \
        && wrap prowler "/opt/prowler/bin/prowler"; \
    python3 -m venv /opt/pacu && /opt/pacu/bin/pip install --no-cache-dir -q pacu \
        && wrap pacu "/opt/pacu/bin/pacu"; \
    chmod -R a+rX /opt/awscli /opt/scoutsuite /opt/prowler /opt/pacu; \
    for b in aws scout prowler pacu; do command -v "$b" >/dev/null || { echo "MISSING cloud tool: $b"; exit 1; }; done

# cloudfox — release binary (no PyPI, and the Go toolchain from stage 9d is already removed).
RUN set -eu; \
    apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*; \
    CF_VER="$(curl -fsSL https://api.github.com/repos/BishopFox/cloudfox/releases/latest | jq -r .tag_name)"; \
    [ -n "$CF_VER" ] && [ "$CF_VER" != "null" ] || { echo "cloudfox: could not resolve latest tag"; exit 1; }; \
    curl -fsSL "https://github.com/BishopFox/cloudfox/releases/download/${CF_VER}/cloudfox-linux-amd64.zip" -o /tmp/cf.zip; \
    unzip -oq /tmp/cf.zip -d /tmp/cf; \
    install -m0755 "$(find /tmp/cf -type f -name cloudfox | head -1)" /usr/local/bin/cloudfox; \
    rm -rf /tmp/cf /tmp/cf.zip; \
    command -v cloudfox >/dev/null || { echo "MISSING cloud tool: cloudfox"; exit 1; }

# --- 9e-quater. web3 / smart-contract audit tooling (Queue-3 web3 build) -------
# The tools the /code-scan web3 audit playbooks propose as an approve-each tool pass. Each Python
# analyzer gets its OWN venv (their pins conflict — slither/mythril both pin web3/eth-* hard) and a
# PATH wrapper, the mkvenv idiom above. THE BINARY NAME IS VERIFIED, not assumed (kali-sandbox
# image trap): `slither-analyzer` ships the `slither` entrypoint, `mythril` ships `myth`; those are
# the names the catalog templates + codescan/web3_tools.py hardcode. echidna/foundry/gosec have no
# PyPI package — each ships a release binary, fetched like cloudfox. Every binary is smoke-checked
# so a bad install fails the build, and docker/proof/web3_install_proof.sh re-checks that every
# name the catalog templates hardcode resolves inside the running container.
RUN set -eu; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    python3 -m venv /opt/slither && /opt/slither/bin/pip install --no-cache-dir -q slither-analyzer \
        && wrap slither "/opt/slither/bin/slither"; \
    python3 -m venv /opt/mythril && /opt/mythril/bin/pip install --no-cache-dir -q mythril \
        && wrap myth "/opt/mythril/bin/myth"; \
    python3 -m venv /opt/semgrep && /opt/semgrep/bin/pip install --no-cache-dir -q semgrep \
        && wrap semgrep "/opt/semgrep/bin/semgrep"; \
    chmod -R a+rX /opt/slither /opt/mythril /opt/semgrep; \
    for b in slither myth semgrep; do command -v "$b" >/dev/null || { echo "MISSING web3 tool: $b"; exit 1; }; done

# echidna — release binary (Haskell; no PyPI). crytic ships a single static `echidna`. The asset
# is named with the BARE version (echidna-2.3.3-x86_64-linux.tar.gz), so strip the tag's `v`.
RUN set -eu; \
    E_VER="$(curl -fsSL https://api.github.com/repos/crytic/echidna/releases/latest | jq -r .tag_name)"; \
    [ -n "$E_VER" ] && [ "$E_VER" != "null" ] || { echo "echidna: could not resolve latest tag"; exit 1; }; \
    ENUM="${E_VER#v}"; \
    curl -fsSL "https://github.com/crytic/echidna/releases/download/${E_VER}/echidna-${ENUM}-x86_64-linux.tar.gz" -o /tmp/ech.tgz; \
    tar -xzf /tmp/ech.tgz -C /tmp; \
    install -m0755 "$(find /tmp -maxdepth 2 -type f -name echidna | head -1)" /usr/local/bin/echidna; \
    rm -rf /tmp/ech.tgz /tmp/echidna*; \
    command -v echidna >/dev/null || { echo "MISSING web3 tool: echidna"; exit 1; }

# foundry — forge + cast (+ anvil) from the official release tarball. The PoC harness.
RUN set -eu; \
    F_VER="$(curl -fsSL https://api.github.com/repos/foundry-rs/foundry/releases/latest | jq -r .tag_name)"; \
    [ -n "$F_VER" ] && [ "$F_VER" != "null" ] || { echo "foundry: could not resolve latest tag"; exit 1; }; \
    curl -fsSL "https://github.com/foundry-rs/foundry/releases/download/${F_VER}/foundry_${F_VER}_linux_amd64.tar.gz" -o /tmp/foundry.tgz; \
    tar -xzf /tmp/foundry.tgz -C /usr/local/bin forge cast anvil chisel 2>/dev/null || tar -xzf /tmp/foundry.tgz -C /usr/local/bin; \
    chmod 0755 /usr/local/bin/forge /usr/local/bin/cast; \
    rm -f /tmp/foundry.tgz; \
    for b in forge cast; do command -v "$b" >/dev/null || { echo "MISSING web3 tool: $b"; exit 1; }; done

# gosec — Go static analysis release binary; plus the Go toolchain so `go vet` works on Cosmos code.
RUN set -eu; \
    GO_VER="$(curl -fsSL https://go.dev/VERSION?m=text | head -1)"; \
    [ -n "$GO_VER" ] || { echo "go: could not resolve latest version"; exit 1; }; \
    curl -fsSL "https://go.dev/dl/${GO_VER}.linux-amd64.tar.gz" -o /tmp/go.tgz; \
    rm -rf /usr/local/go && tar -xzf /tmp/go.tgz -C /usr/local && rm -f /tmp/go.tgz; \
    ln -sf /usr/local/go/bin/go /usr/local/bin/go && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt; \
    G_VER="$(curl -fsSL https://api.github.com/repos/securego/gosec/releases/latest | jq -r .tag_name)"; \
    [ -n "$G_VER" ] && [ "$G_VER" != "null" ] || { echo "gosec: could not resolve latest tag"; exit 1; }; \
    GNUM="${G_VER#v}"; \
    curl -fsSL "https://github.com/securego/gosec/releases/download/${G_VER}/gosec_${GNUM}_linux_amd64.tar.gz" -o /tmp/gosec.tgz; \
    tar -xzf /tmp/gosec.tgz -C /usr/local/bin gosec && rm -f /tmp/gosec.tgz; \
    chmod 0755 /usr/local/bin/gosec; \
    for b in go gosec; do command -v "$b" >/dev/null || { echo "MISSING web3 tool: $b"; exit 1; }; done

# Rust + clippy + Anchor (Solana). rustup installs the toolchain; clippy is a component; anchor-cli
# is built from source (the heaviest layer in this stage — several minutes). CARGO_HOME/RUSTUP_HOME
# are baked under /opt so the unprivileged `sandbox` user can invoke them.
ENV RUSTUP_HOME=/opt/rust/rustup CARGO_HOME=/opt/rust/cargo PATH=/opt/rust/cargo/bin:$PATH
RUN set -eu; \
    curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --component clippy; \
    /opt/rust/cargo/bin/cargo install --locked --git https://github.com/coral-xyz/anchor anchor-cli 2>/dev/null \
        || echo "NOTE: anchor-cli build skipped/failed — clippy+cargo still present; install anchor via avm if needed"; \
    chmod -R a+rX /opt/rust; \
    for b in cargo clippy-driver; do command -v "$b" >/dev/null || { echo "MISSING web3 tool: $b"; exit 1; }; done

# mythril's eth/py-evm dependency does `import pkg_resources`, which (a) a Python 3.13 `venv` no
# longer ships and (b) setuptools >=81 has REMOVED — so `myth` cannot even start without a
# `setuptools<81` pinned into its venv. slither's venv does not touch pkg_resources, which is why
# only myth needs this. Kept as its OWN late layer so an incremental rebuild reuses the cached
# (expensive) anchor-cli compile above instead of re-running it.
RUN set -eu; \
    /opt/mythril/bin/pip install --no-cache-dir -q "setuptools<81"; \
    /opt/mythril/bin/myth version >/dev/null 2>&1 || { echo "MISSING web3 tool: myth cannot start"; exit 1; }

# --- 9e-bis. GraphQL tooling (build #20 item 6) ---
#
# *** TWO OF THESE FOUR MUST NOT COME FROM PyPI, AND THAT IS A SUPPLY-CHAIN FINDING. ***
# `pip install graphw00f` installs a package whose own summary reads "Inert defensive-hold
# placeholder for an unclaimed PyPI name referenced by a public agent skill. NOT the real tool"
# (Metano Labs, 0.0.1, one release). `pip install graphql-cop` installs "Reserved name
# placeholder. No functionality." (0.0.1, one release). Both real projects are dolevf/* on GitHub
# and neither publishes to PyPI. Somebody has parked those names precisely BECAUSE tooling
# guides name them and an agent will reach for pip — so the obvious install line is the wrong
# one, quietly, with a package that runs and finds nothing. Verified 2026-08-05 by reading the
# PyPI metadata for all four before installing any of them.
#
# The other two ARE genuine on PyPI and are taken from there: `inql` 4.0.5 (Andrea Brancaleoni,
# Doyensec, 12 releases) and `clairvoyance` 2.5.5 (Nikita Stupin, the project's own repo in its
# metadata).
#
# All four were run against a live GraphQL endpoint inside this container before being written
# down; none is catalogued on the strength of a `--help` alone. `graphw00f` has no
# requirements.txt and needs `requests`, which is why it is not built with `mkvenv`.
RUN set -eu; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    git clone --depth 1 https://github.com/dolevf/graphw00f /opt/graphw00f; \
        python3 -m venv /opt/graphw00f/venv; \
        /opt/graphw00f/venv/bin/pip install --no-cache-dir -q requests; \
        wrap graphw00f "/opt/graphw00f/venv/bin/python /opt/graphw00f/main.py"; \
    git clone --depth 1 https://github.com/dolevf/graphql-cop /opt/graphql-cop; \
        python3 -m venv /opt/graphql-cop/venv; \
        /opt/graphql-cop/venv/bin/pip install --no-cache-dir -q -r /opt/graphql-cop/requirements.txt; \
        wrap graphql-cop "/opt/graphql-cop/venv/bin/python /opt/graphql-cop/graphql-cop.py"; \
    python3 -m venv /opt/inql-venv; \
        /opt/inql-venv/bin/pip install --no-cache-dir -q inql; \
        wrap inql "/opt/inql-venv/bin/inql"; \
    python3 -m venv /opt/clairvoyance-venv; \
        /opt/clairvoyance-venv/bin/pip install --no-cache-dir -q clairvoyance; \
        wrap clairvoyance "/opt/clairvoyance-venv/bin/python -m clairvoyance"; \
    chmod -R a+rX /opt/graphw00f /opt/graphql-cop /opt/inql-venv /opt/clairvoyance-venv; \
    for b in graphw00f graphql-cop inql clairvoyance; do command -v "$b" >/dev/null; done

# --- 9f. gf pattern packs + a static resolver list (baked — no runtime egress) ---
# gf is inert without pattern packs; the lab has no egress so they must be present in the
# image. Merge 1ndianl33t/Gf-Patterns with tomnomnom/gf's own examples into a shared dir and
# symlink it as root's ~/.gf (the sandbox user's ~/.gf is symlinked in the users layer below).
# The resolver list is the offline default for puredns/massdns; dnsvalidator refreshes it only
# where there is egress (engagement / :kali).
RUN git clone --depth 1 https://github.com/1ndianl33t/Gf-Patterns /tmp/gfp \
    && git clone --depth 1 https://github.com/tomnomnom/gf /tmp/gf \
    && mkdir -p /usr/share/gf-patterns \
    && cp /tmp/gfp/*.json /usr/share/gf-patterns/ \
    && cp /tmp/gf/examples/*.json /usr/share/gf-patterns/ 2>/dev/null || true \
    && rm -rf /tmp/gfp /tmp/gf \
    && ln -sfn /usr/share/gf-patterns /root/.gf \
    && test -n "$(ls /usr/share/gf-patterns/*.json 2>/dev/null)" \
    && { curl -fsSL https://raw.githubusercontent.com/trickest/resolvers/main/resolvers.txt \
            -o /usr/share/resolvers.txt \
         || printf '%s\n' 1.1.1.1 8.8.8.8 8.8.4.4 9.9.9.9 1.0.0.1 208.67.222.222 208.67.220.220 \
            > /usr/share/resolvers.txt; } \
    && test -s /usr/share/resolvers.txt

# --- 9b. C2 + evasion (build #4) ----------------------------------------------
# Everything here was probed against THIS image's kali-rolling snapshot before being written,
# because three of the five tools are not packaged and one is already installed:
#   * dnscat2   — NOT in kali-rolling (verified with apt-cache policy, not assumed). Built from
#                 source: the client is C (make) and the server is Ruby, and both gcc/make and
#                 ruby are already in the image. Installed under the HYPHENATED names the
#                 arsenal catalog advertises, so the catalog and the image agree.
#   * iodine    — ALREADY PRESENT from the Kali toolset layer at /usr/sbin/iodine(d).
#                 Nothing to install; it is only smoke-tested below so a future base-image
#                 change that drops it fails the build instead of shipping a broken catalog.
#   * sliver    — NOT packaged, and there is NO Go toolchain in this image (deliberately: the
#                 Go layer is not kept). Official release binaries are the only option, which
#                 also dodges the Go-version floor that a `go install` would impose.
#   * donut     — no apt candidate and no py3.13 wheel, only a source tarball; it is a C
#                 extension and gcc is present, so it builds. Own venv per this file's
#                 convention (PEP 668 makes system pip a non-starter on Kali anyway).
#   * ScareCrow — NOT packaged; release binary. Its signing step shells out to osslsigncode,
#                 which IS available (2.13-2) and is installed alongside it as a HARD
#                 requirement (no `|| true`) — the consolidated smoke test asserts it runs.
#                 Note the release asset is tagged v5.1 and named
#                 ScareCrow_5.1_linux_amd64 — there is no 5.1.x asset; a guessed patch
#                 version 404s and fails this layer.
#
# SMOKE TESTS MUST CARRY A STATUS. Every step ends in a smoke test so a bad URL or a moved
# release fails the build loudly — but `tool -h | head -1` does NOT do that: the exit status of
# a pipeline is the LAST command's, so `head` returns 0 even when the tool is missing, empty or
# dies on its first line. `|| true` is the same failure with the intent written down. Every
# invocation below therefore ends in `grep -q`, which fails when the tool produces no output.
# Regression-locked in backend/test_evasion.py.

# Sliver — release binaries (server + client).
ARG SLIVER_VERSION=1.5.42
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/sliver-server \
        "https://github.com/BishopFox/sliver/releases/download/v${SLIVER_VERSION}/sliver-server_linux"; \
    curl -fsSL -o /usr/local/bin/sliver-client \
        "https://github.com/BishopFox/sliver/releases/download/v${SLIVER_VERSION}/sliver-client_linux"; \
    chmod 0755 /usr/local/bin/sliver-server /usr/local/bin/sliver-client; \
    /usr/local/bin/sliver-server version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    /usr/local/bin/sliver-client version 2>&1 | grep -q "v${SLIVER_VERSION}"

# dnscat2 — DNS-tunnelled channel. Client compiled from source; server is the shipped Ruby.
# Wrapped as dnscat2-server / dnscat2-client to match backend/arsenal/tools.json.
# The server's four gems (trollop/salsa20/sha3/ecdsa, per its own Gemfile) are NOT optional —
# without them dnscat2.rb dies on `require 'ecdsa'`. dnscat2.rb has no --help of its own, so
# the gems are asserted DIRECTLY below; a missing gem fails the build rather than surfacing at
# engagement time.
# Pinned by docker/pin-build4-versions.sh: dnscat2 has no release tags, so the client is
# built from a fixed commit, and the four gems plus donut-shellcode carry exact versions.
# Re-run that script to move the pins forward.
ARG DNSCAT2_COMMIT=42f8d783488836c0e24ff25571684170be0a0cc2
RUN set -eux; \
    git clone https://github.com/iagox86/dnscat2.git /opt/dnscat2; \
    git -C /opt/dnscat2 checkout --detach "${DNSCAT2_COMMIT}"; \
    make -C /opt/dnscat2/client; \
    install -m 0755 /opt/dnscat2/client/dnscat /usr/local/bin/dnscat2-client; \
    gem install --no-document trollop:2.9.10 salsa20:0.1.3 sha3:2.2.4 ecdsa:1.2.0; \
    printf '%s\n' '#!/bin/sh' 'exec ruby /opt/dnscat2/server/dnscat2.rb "$@"' \
        > /usr/local/bin/dnscat2-server; \
    chmod 0755 /usr/local/bin/dnscat2-server; \
    /usr/local/bin/dnscat2-client --help 2>&1 | grep -qi dnscat; \
    ruby -e "require 'ecdsa'; require 'salsa20'; require 'sha3'; require 'trollop'; puts 'dnscat2 server gems ok'"

# iodine — already installed by the Kali toolset layer; assert it, do not reinstall.
RUN set -eux; \
    command -v iodine; \
    command -v iodined; \
    iodine -h 2>&1 | grep -qi iodine

# donut — shellcode-from-PE generator, in its own venv (this file's convention).
# donut-shellcode is a C EXTENSION exposing exactly one callable, `donut.create(...)`. It has
# no console_script and no __main__, so `python -m donut` cannot work — the CLI below is ours,
# and its -i/-o/-a flags are what backend/arsenal/tools.json advertises.
RUN set -eux; \
    python3 -m venv /opt/donut/venv; \
    /opt/donut/venv/bin/pip install --no-cache-dir -q donut-shellcode==1.1; \
    /opt/donut/venv/bin/python -c "import donut; assert callable(donut.create)"; \
    printf '%s\n' \
        '#!/opt/donut/venv/bin/python' \
        '"""Minimal CLI over donut-shellcode (the module ships none)."""' \
        'import argparse, sys, donut' \
        'p = argparse.ArgumentParser(prog="donut", description="PE/.NET -> position-independent shellcode")' \
        'p.add_argument("-i", "--input", required=True, help="input .exe/.dll assembly")' \
        'p.add_argument("-o", "--output", default="loader.bin", help="output shellcode file")' \
        'p.add_argument("-a", "--arch", type=int, default=3, choices=(1, 2, 3), help="1=x86 2=amd64 3=both")' \
        'p.add_argument("-p", "--params", default="", help="parameters passed to the entry point")' \
        'a = p.parse_args()' \
        'n = donut.create(file=a.input, output=a.output, arch=a.arch, params=a.params or None)' \
        'if not n:' \
        '    sys.exit("donut: generation failed")' \
        'print(f"{n} bytes -> {a.output}")' \
        > /usr/local/bin/donut; \
    chmod 0755 /usr/local/bin/donut; \
    /usr/local/bin/donut --help >/dev/null

# ScareCrow — loader generator. Its signing step shells out to osslsigncode, which IS in this
# snapshot (2.13-2) and is a HARD requirement here: no `|| true`, so a snapshot that drops it
# fails this layer rather than shipping a ScareCrow whose signing path is broken.
ARG SCARECROW_VERSION=5.1
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends osslsigncode \
        && rm -rf /var/lib/apt/lists/*; \
    curl -fsSL -o /tmp/scarecrow \
        "https://github.com/optiv/ScareCrow/releases/download/v${SCARECROW_VERSION}/ScareCrow_${SCARECROW_VERSION}_linux_amd64"; \
    install -m 0755 /tmp/scarecrow /usr/local/bin/ScareCrow; \
    rm -f /tmp/scarecrow; \
    /usr/local/bin/ScareCrow -h 2>&1 | grep -qi scarecrow

# proxychains, pointed at the tunnel HackPit actually starts.
#
# Debian ships /etc/proxychains4.conf configured for Tor (`socks4 127.0.0.1 9050`). HackPit's
# chisel plan brings up a reverse SOCKS5 on THIS box at 127.0.0.1:1080 (cockpit/tunnels.py,
# CHISEL_SOCKS_PORT) and `wrap_command` rewrites a command to `proxychains -q …` on the strength
# of that — so with the stock config the rewritten command the operator approves would quietly
# try Tor and time out. Found by the live-fire run, which is exactly the class of gap a proof
# harness exists to find: every unit test passed, and the shipped path could not work.
#
# The Tor line is replaced rather than appended to: proxychains reads the LAST [ProxyList]
# section, and leaving 9050 in place makes the chain depend on ordering.
RUN set -eux; \
    sed -i 's|^socks4[[:space:]].*|socks5 127.0.0.1 1080|' /etc/proxychains4.conf; \
    grep -q '^socks5 127.0.0.1 1080' /etc/proxychains4.conf; \
    ! grep -q '^socks4' /etc/proxychains4.conf

# One consolidated smoke test: the build FAILS if any advertised binary is missing OR broken.
# A `command -v` check alone is not a smoke test — it passes for a binary that dies on its
# first line. Neither is `tool -h | head -1`: a pipeline's status is the LAST command's, so
# `head` returns 0 for a tool that never ran. And `|| true` discards the status outright —
# ScareCrow was checked that way, making it the one advertised binary whose brokenness could
# not fail this build. Every tool below is INVOKED and its OUTPUT asserted with `grep -q`,
# which fails on an empty or absent one. (dnscat2-server has no --help of its own, so its gems
# are asserted directly; ScareCrow exits non-zero on -h by design, which grep does not care
# about — grep sees the usage banner either way.)
#
# THE SLIVER PAIR MATCHES THE PINNED VERSION, NOT THE WORD "sliver" (build #7). Both were
# checked with `grep -qi sliver` — and `sliver-server version` prints exactly
# `v1.5.42 - <sha>`, which does not contain the string "sliver". That assertion could never
# pass, so this layer could never build; the image in the registry predates the check. The
# static test that guards this block (backend/test_evasion.py) reads the SHAPE of these lines
# — `|| true`, `| head` — and cannot know whether a grep pattern actually matches, so only a
# real build surfaced it. Matching "v${SLIVER_VERSION}" is strictly stronger than the name
# would have been: it fails when the binary is missing, dies, or is not the version pinned
# above.
RUN set -eux; \
    for b in sliver-server sliver-client dnscat2-server dnscat2-client iodine iodined donut ScareCrow; do \
        command -v "$b" >/dev/null || { echo "MISSING: $b"; exit 1; }; \
    done; \
    sliver-server version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    sliver-client version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    dnscat2-client --help 2>&1 | grep -qi dnscat; \
    ruby -e "require 'ecdsa'; require 'salsa20'; require 'sha3'; require 'trollop'"; \
    iodine -h 2>&1 | grep -qi iodine; \
    iodined -h 2>&1 | grep -qi iodine; \
    donut --help 2>&1 | grep -qi shellcode; \
    ScareCrow -h 2>&1 | grep -qi scarecrow; \
    osslsigncode --version >/dev/null; \
    echo "build #4 C2/evasion toolset present and each tool runs"

# --- 9g. curl-impersonate — a browser-FIDELITY HTTP client (build #18 item 5) --
#
# *** WHAT THIS IS FOR, AS A MEASUREMENT RATHER THAN A HOPE. ***
# Build #17 drove eleven assets of a live bug bounty program. NINE OF THEM REFUSED A BARE HTTP
# CLIENT OUTRIGHT — h2 stream reset on HTTP/2, timeout on HTTP/1.1: two different failure modes
# on two protocols, which is an edge refusing the client rather than a quirk. `ffuf`, `nuclei`,
# `httpx` and `curl` never reached request one. A real headed browser through the proxy fetched
# 2.3 MB from the same host in 3.7 seconds.
#
# The diagnostic also found WHY, and it is the reason a User-Agent string does not help:
#
#     headed Chromium       Sec-CH-UA present   ->  31x 200
#     headless, stock UA    Sec-CH-UA ABSENT    ->  504
#     headless, SPOOFED UA  Sec-CH-UA ABSENT    ->  504
#
# The discriminator is the HEADER SET AND THE TLS HANDSHAKE a real browser emits, not the string
# it claims to be. curl-impersonate is a curl built against BoringSSL/nss with Chrome's and
# Firefox's cipher order, TLS extension order, HTTP/2 SETTINGS frame, pseudo-header order and
# full default header set — so the wrapper scripts below send what a browser sends because they
# are configured to, not because they say they are.
#
# THE WRAPPER SCRIPTS ARE THE PRODUCT, NOT THE BINARY. `curl-impersonate-chrome` on its own is
# just a curl with a different TLS library; the `curl_chrome*` wrappers carry the header list and
# the ciphers. Asserting only that the binary runs would be exactly build #15's lesson — "a
# successful version string is not a result" — so this layer asserts BOTH the binaries and the
# wrappers, and the real proof (a request bare curl cannot complete, completing) lives in
# docs/proof/ because it needs a WAF-fronted host.
#
# RECORDED HONESTLY: this makes HackPit's traffic indistinguishable from a browser's. It is
# built deliberately, for an authorized safe-harbour program, and it introduces NO new gate and
# no relaxation of one — it is an ordinary binary in the sandbox and every run of it goes through
# the same four gates as `curl` itself.
#
# The pinned release impersonates Chrome 116 / Firefox 109. Whether that vintage still satisfies
# a 2026 bot manager is a MEASUREMENT, not an assumption, and the proof script is where it gets
# made — including the outcome where it does not work, which is a legitimate result.
ARG CURL_IMPERSONATE_VERSION=0.6.1
RUN set -eux; \
    curl -fsSL "https://github.com/lwthiker/curl-impersonate/releases/download/v${CURL_IMPERSONATE_VERSION}/curl-impersonate-v${CURL_IMPERSONATE_VERSION}.x86_64-linux-gnu.tar.gz" \
      -o /tmp/curl-impersonate.tgz; \
    mkdir -p /opt/curl-impersonate; \
    tar -xzf /tmp/curl-impersonate.tgz -C /opt/curl-impersonate; \
    rm -f /tmp/curl-impersonate.tgz; \
    find /opt/curl-impersonate -maxdepth 1 -type f -exec chmod 0755 {} +; \
    for f in /opt/curl-impersonate/curl-impersonate-* /opt/curl-impersonate/curl_*; do \
        [ -f "$f" ] || continue; ln -sf "$f" "/usr/local/bin/$(basename "$f")"; \
    done; \
    command -v curl-impersonate-chrome >/dev/null; \
    command -v curl-impersonate-ff >/dev/null; \
    curl-impersonate-chrome --version | grep -qi curl; \
    curl-impersonate-ff --version | grep -qi curl; \
    ls /usr/local/bin/curl_chrome* >/dev/null; \
    ls /usr/local/bin/curl_ff* >/dev/null; \
    echo "curl-impersonate ${CURL_IMPERSONATE_VERSION}: binaries AND browser wrappers present"

# --- 9h. binary-RE / exploit-dev tooling (binary-ctf-arsenal build) -----------
# The reversing / pwn toolset the binary-re catalog entries propose as approve-each tools. apt
# covers most; pwntools + angr get their OWN venvs (heavy, conflicting pins) and the catalog
# templates invoke that venv's python3 directly — which is why `python3` is the tell the
# red-confirm fires on, not the tool name. one_gadget is a Ruby gem; libc-database is a git repo
# (no package, invoked by absolute path); pwninit ships a static release binary.
#
# THE BINARY NAME IS VERIFIED, not assumed (kali-sandbox image trap): `python3-ropgadget` ships
# the `ROPgadget` entrypoint, and Ghidra's headless launcher is `analyzeHeadless` under
# /usr/share/ghidra/support — NOT `ghidra` — so it is symlinked onto PATH for the catalog's
# `analyzeHeadless <...>` template. Each binary is smoke-tested (command -v alone is not a smoke
# test — build #4's lesson), so a bad package name fails HERE, not at analysis time.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        radare2 rizin binutils nasm patchelf checksec ropper \
        xxd python3-ropgadget \
    && rm -rf /var/lib/apt/lists/* \
    && for b in r2 rizin objdump readelf nm nasm patchelf checksec ropper xxd ROPgadget; do \
           command -v "$b" >/dev/null || { echo "MISSING binary-re tool: $b"; exit 1; }; \
       done

# Ghidra — the headless decompiler. Its own layer: the apt package is large (pulls a JDK) and
# stable, so an edit to the tools around it must not force it to rebuild. The launcher the
# catalog names lives under support/, not on PATH, so it is discovered and symlinked.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ghidra \
    && rm -rf /var/lib/apt/lists/* \
    && HL="$(find /usr /opt -name analyzeHeadless -type f 2>/dev/null | head -1)" \
    && [ -n "$HL" ] || { echo "MISSING binary-re tool: analyzeHeadless (ghidra layout changed)"; exit 1; } \
    && ln -sfn "$HL" /usr/local/bin/analyzeHeadless \
    && command -v analyzeHeadless >/dev/null

# one_gadget — Ruby gem (ruby is already in the image). Installs the `one_gadget` executable.
RUN gem install --no-document one_gadget \
    && command -v one_gadget >/dev/null \
    && one_gadget --help 2>&1 | grep -qi gadget

# pwntools — its own venv; symlink the framework's `pwn` CLI onto PATH as `pwn` and `pwntools`
# (so startup reconciliation resolves the catalog name). The exploit-skeleton template calls
# /opt/pwntools/venv/bin/python3 directly.
RUN set -eu; \
    python3 -m venv /opt/pwntools/venv; \
    /opt/pwntools/venv/bin/pip install --no-cache-dir -q pwntools; \
    ln -sf /opt/pwntools/venv/bin/pwn /usr/local/bin/pwn; \
    ln -sf /opt/pwntools/venv/bin/pwn /usr/local/bin/pwntools; \
    chmod -R a+rX /opt/pwntools; \
    /opt/pwntools/venv/bin/python3 -c 'import pwnlib; print(pwnlib.__version__)' >/dev/null; \
    command -v pwn >/dev/null && command -v pwntools >/dev/null

# angr — its own venv (heavy: z3, unicorn, capstone). The catalog template calls the venv python3
# directly; a tiny `angr` PATH wrapper exists only so startup reconciliation can resolve the name
# and prove the module imports.
RUN set -eu; \
    python3 -m venv /opt/angr/venv; \
    /opt/angr/venv/bin/pip install --no-cache-dir -q angr; \
    printf 'import angr\nprint("angr", angr.__version__)\n' > /opt/angr/version.py; \
    printf '#!/bin/sh\nexec /opt/angr/venv/bin/python3 /opt/angr/version.py\n' > /usr/local/bin/angr; \
    chmod 0755 /usr/local/bin/angr; \
    chmod -R a+rX /opt/angr; \
    /opt/angr/venv/bin/python3 -c 'import angr; print(angr.__version__)' >/dev/null; \
    command -v angr >/dev/null

# libc-database — git repo, invoked by absolute path (the catalog template is /opt/libc-database/
# find). NOT symlinked onto PATH: the basename would collide with coreutils `find`. The symbol DB
# is built with ./get, which needs egress — do it in the engagement / :kali sandbox, never the
# airgapped lab.
RUN git clone --depth 1 https://github.com/niklasb/libc-database /opt/libc-database \
    && chmod -R a+rX /opt/libc-database \
    && test -x /opt/libc-database/find

# pwninit — static release binary (Rust; the asset is a bare `pwninit`).
RUN set -eu; \
    P_VER="$(curl -fsSL https://api.github.com/repos/io12/pwninit/releases/latest | jq -r .tag_name)"; \
    [ -n "$P_VER" ] && [ "$P_VER" != "null" ] || { echo "pwninit: could not resolve latest tag"; exit 1; }; \
    curl -fsSL "https://github.com/io12/pwninit/releases/download/${P_VER}/pwninit" -o /usr/local/bin/pwninit; \
    chmod 0755 /usr/local/bin/pwninit; \
    command -v pwninit >/dev/null; \
    pwninit --version 2>&1 | grep -qi pwninit

# --- 9i. forensics / CTF tooling (binary-ctf-arsenal build) -------------------
# Memory-forensics, carving, stego and metadata analysis of a local <file>. apt covers most;
# volatility3 gets its own venv (the `vol` entrypoint is symlinked, plus `vol.py` for the
# catalog alias); zsteg is a Ruby gem; stegseek is taken from apt when present, otherwise its
# release .deb. THE BINARY NAME IS VERIFIED (image trap): the `bulk-extractor` package ships
# `bulk_extractor`, `testdisk` ships both `testdisk` and `photorec`, and
# `libimage-exiftool-perl` ships `exiftool`.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binwalk foremost scalpel steghide bulk-extractor testdisk \
        libimage-exiftool-perl \
    && rm -rf /var/lib/apt/lists/* \
    && for b in binwalk foremost scalpel steghide bulk_extractor testdisk photorec exiftool; do \
           command -v "$b" >/dev/null || { echo "MISSING forensics tool: $b"; exit 1; }; \
       done

# volatility3 — own venv; `vol` + `vol.py` onto PATH (the catalog templates + aliases).
RUN set -eu; \
    python3 -m venv /opt/volatility3/venv; \
    /opt/volatility3/venv/bin/pip install --no-cache-dir -q volatility3; \
    ln -sf /opt/volatility3/venv/bin/vol /usr/local/bin/vol; \
    ln -sf /opt/volatility3/venv/bin/vol /usr/local/bin/vol.py; \
    chmod -R a+rX /opt/volatility3; \
    command -v vol >/dev/null; \
    /opt/volatility3/venv/bin/vol -h >/dev/null 2>&1

# zsteg — Ruby gem; installs the `zsteg` executable.
RUN gem install --no-document zsteg \
    && command -v zsteg >/dev/null \
    && zsteg --help 2>&1 | grep -qi zsteg

# stegseek — apt where the snapshot ships it, else the upstream release .deb (pinned to latest).
RUN set -eu; \
    apt-get update; \
    if apt-get install -y --no-install-recommends stegseek 2>/dev/null; then \
        echo "stegseek: from apt"; \
    else \
        S_VER="$(curl -fsSL https://api.github.com/repos/RickdeJager/stegseek/releases/latest | jq -r .tag_name)"; \
        [ -n "$S_VER" ] && [ "$S_VER" != "null" ] || { echo "stegseek: could not resolve latest tag"; exit 1; }; \
        curl -fsSL "https://github.com/RickdeJager/stegseek/releases/download/${S_VER}/stegseek_${S_VER#v}-1.deb" -o /tmp/stegseek.deb; \
        apt-get install -y --no-install-recommends /tmp/stegseek.deb; \
        rm -f /tmp/stegseek.deb; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    command -v stegseek >/dev/null; \
    stegseek 2>&1 | grep -qi stegseek

# --- 9j. single-packet / last-byte race client (race-singlepacket build) ------
# The synchronized HTTP client the :race job invokes as ONE approve-each tool pass:
# `docker exec -i <open sandbox> race-singlepacket --job-stdin` with the whole request as JSON on
# stdin. It is a small in-repo client rather than Turbo Intruder, which is a Burp extension and not
# headless. HTTP/2 single-packet needs the `h2` framing library, so it gets its OWN venv (the
# jwt_tool / pwntools idiom) — the h1-last-byte mode is pure stdlib and works even if h2 is absent.
#
# THE WRAPPER IS THE PRODUCT: /usr/local/bin/race-singlepacket execs the venv python against the
# baked script, so the catalog name resolves on PATH exactly like every other tool and the backend
# never has to know the venv path. `--selftest` is the smoke test — `command -v` alone is not one
# (build #4's lesson), so the layer FAILS here if the client cannot even import.
COPY race_singlepacket.py /opt/hackpit/race_singlepacket.py
RUN set -eu; \
    python3 -m venv /opt/race/venv; \
    /opt/race/venv/bin/pip install --no-cache-dir -q h2; \
    chmod 0644 /opt/hackpit/race_singlepacket.py; \
    printf '#!/bin/sh\nexec /opt/race/venv/bin/python3 /opt/hackpit/race_singlepacket.py "$@"\n' \
        > /usr/local/bin/race-singlepacket; \
    chmod 0755 /usr/local/bin/race-singlepacket; \
    chmod -R a+rX /opt/race /opt/hackpit; \
    command -v race-singlepacket >/dev/null; \
    race-singlepacket --selftest | grep -qi 'race-singlepacket ok'; \
    /opt/race/venv/bin/python3 -c 'import h2'

# --- 9k. request-smuggling / desync prober + external CL/TE and h2c tools ------
# The engine the :smuggle job invokes as ONE approve-each tool pass:
# `docker exec -i <open sandbox> smuggle-probe --job-stdin` with the whole request + mutation set as
# JSON on stdin. It is a small in-repo client (like race-singlepacket) so the GATED job has a
# headless engine with a stable JSON contract; defparam's smuggler.py and BishopFox's h2csmuggler
# are the standard external tools, installed alongside for MANUAL use in :kali / :terminal and named
# in tools.json. HTTP/2-downgrade probing needs the `h2` framing library, so all three share ONE
# venv (the race / jwt_tool / pwntools idiom).
#
# THE WRAPPERS ARE THE PRODUCT: /usr/local/bin/{smuggle-probe,smuggler.py,h2csmuggler} exec the venv
# python against the baked/cloned scripts, so each catalog name resolves on PATH under the exact name
# and the backend never has to know a venv path. `--selftest` is the smoke test — `command -v` alone
# is not one (build #4's lesson), so the layer FAILS here if the engine cannot even import.
COPY smuggle_probe.py /opt/hackpit/smuggle_probe.py
RUN set -eu; \
    python3 -m venv /opt/smuggle/venv; \
    /opt/smuggle/venv/bin/pip install --no-cache-dir -q h2 hyperframe; \
    chmod 0644 /opt/hackpit/smuggle_probe.py; \
    printf '#!/bin/sh\nexec /opt/smuggle/venv/bin/python3 /opt/hackpit/smuggle_probe.py "$@"\n' \
        > /usr/local/bin/smuggle-probe; \
    chmod 0755 /usr/local/bin/smuggle-probe; \
    git clone --depth 1 https://github.com/defparam/smuggler.git /opt/smuggle/smuggler; \
    printf '#!/bin/sh\nexec /opt/smuggle/venv/bin/python3 /opt/smuggle/smuggler/smuggler.py "$@"\n' \
        > /usr/local/bin/smuggler.py; \
    chmod 0755 /usr/local/bin/smuggler.py; \
    git clone --depth 1 https://github.com/BishopFox/h2csmuggler.git /opt/smuggle/h2csmuggler; \
    if [ -f /opt/smuggle/h2csmuggler/requirements.txt ]; then \
        /opt/smuggle/venv/bin/pip install --no-cache-dir -q -r /opt/smuggle/h2csmuggler/requirements.txt; \
    else \
        /opt/smuggle/venv/bin/pip install --no-cache-dir -q hpack; \
    fi; \
    printf '#!/bin/sh\nexec /opt/smuggle/venv/bin/python3 /opt/smuggle/h2csmuggler/h2csmuggler.py "$@"\n' \
        > /usr/local/bin/h2csmuggler; \
    chmod 0755 /usr/local/bin/h2csmuggler; \
    chmod -R a+rX /opt/smuggle /opt/hackpit; \
    command -v smuggle-probe >/dev/null; \
    smuggle-probe --selftest | grep -qi 'smuggle-probe ok'; \
    /opt/smuggle/venv/bin/python3 -c 'import h2, hyperframe'; \
    command -v smuggler.py >/dev/null; \
    smuggler.py -h >/dev/null 2>&1 || smuggler.py --help >/dev/null 2>&1 || true; \
    command -v h2csmuggler >/dev/null; \
    h2csmuggler -h >/dev/null 2>&1 || true

# --- 9l. web-cache-poisoning / cache-deception prober -------------------------
# The engine the :cache job invokes as ONE approve-each tool pass:
# `docker exec -i <open sandbox> cache-probe --job-stdin` with the whole request + candidate-input
# set as JSON on stdin. It is a small in-repo client (like race-singlepacket / smuggle-probe) so the
# GATED job has a headless engine with a stable JSON contract. It uses ONLY the Python stdlib (json,
# urllib, ssl, re) — no venv, no third-party deps — so the wrapper execs the system python3 directly.
# `--selftest` is the smoke test — `command -v` alone is not one (build #4's lesson), so the layer
# FAILS here if the engine cannot even import.
COPY cache_probe.py /opt/hackpit/cache_probe.py
RUN set -eu; \
    chmod 0644 /opt/hackpit/cache_probe.py; \
    printf '#!/bin/sh\nexec python3 /opt/hackpit/cache_probe.py "$@"\n' \
        > /usr/local/bin/cache-probe; \
    chmod 0755 /usr/local/bin/cache-probe; \
    chmod -R a+rX /opt/hackpit; \
    command -v cache-probe >/dev/null; \
    cache-probe --selftest | grep -qi 'cache-probe ok'

# --- 9m. wcvs (Hackmanit Web-Cache-Vulnerability-Scanner) — Go ----------------
# The standard external cache-poisoning scanner the arsenal names, installed for MANUAL use in
# :kali / :terminal. No kali package exists, so it is built from source. WCVS's recent deps
# (fasthttp v1.65, golang.org/x/net v0.43) need a CURRENT Go — the pinned reconFTW go1.23.4 CANNOT
# build them (it fails compiling the newer stdlib: "undefined: goarch.PtrBits" / "abi.MapGroupSlots").
# So this fetches the LATEST Go (the gosec layer's proven `go.dev/VERSION` pattern) into a THROWAWAY
# dir — never /usr/local/go, so the web3 layer's toolchain is left untouched — builds, symlinks the
# module-named binary to the short name `wcvs`, then removes the temp toolchain + caches so only the
# binary ships. Smoke-checked so a bad build fails the layer here.
RUN set -eu; \
    GO_VER="$(curl -fsSL https://go.dev/VERSION?m=text | head -1)"; \
    [ -n "$GO_VER" ] || { echo "wcvs: could not resolve the latest Go version"; exit 1; }; \
    curl -fsSL "https://go.dev/dl/${GO_VER}.linux-amd64.tar.gz" -o /tmp/wcvsgo.tgz; \
    mkdir -p /opt/wcvs-go; \
    tar -C /opt/wcvs-go -xzf /tmp/wcvsgo.tgz; \
    rm /tmp/wcvsgo.tgz; \
    export PATH="/opt/wcvs-go/go/bin:$PATH" GOBIN=/usr/local/bin GOFLAGS=-buildvcs=false GOTOOLCHAIN=auto; \
    go install github.com/Hackmanit/Web-Cache-Vulnerability-Scanner@latest; \
    if [ -x /usr/local/bin/Web-Cache-Vulnerability-Scanner ]; then \
        ln -sfn /usr/local/bin/Web-Cache-Vulnerability-Scanner /usr/local/bin/wcvs; \
    fi; \
    rm -rf /opt/wcvs-go /root/go /root/.cache/go-build; \
    command -v wcvs >/dev/null; \
    wcvs --help >/dev/null 2>&1 || wcvs -h >/dev/null 2>&1 || true

# --- 9n. JS-recon engine (js-mine) --------------------------------------------
# The engine the :jsrecon job invokes as ONE approve-each pass:
# `docker exec -i <engage sandbox> js-mine --job-stdin` with the (already scope-filtered) JS URL set
# as JSON on stdin. It is a small in-repo client (like cache-probe / race-singlepacket) so the GATED
# job has a headless miner with a stable JSON contract. It uses ONLY the Python stdlib (json, re, ssl,
# urllib) plus an OPTIONAL shell-out to trufflehog (installed above) for VERIFIED keys — no venv, no
# third-party deps — so the wrapper execs the system python3 directly. `--selftest` is the smoke test:
# `command -v` alone is not one (build #4's lesson), so the layer FAILS here if the engine cannot mine
# its planted fixture.
COPY js_mine.py /opt/hackpit/js_mine.py
RUN set -eu; \
    chmod 0644 /opt/hackpit/js_mine.py; \
    printf '#!/bin/sh\nexec python3 /opt/hackpit/js_mine.py "$@"\n' \
        > /usr/local/bin/js-mine; \
    chmod 0755 /usr/local/bin/js-mine; \
    chmod -R a+rX /opt/hackpit; \
    command -v js-mine >/dev/null; \
    js-mine --selftest | grep -qi 'js-mine ok'

# --- 9o. JS-recon EXTERNAL toolchain (manual use, catalogued in tools.json) ----
# The standard tools the arsenal names for hand JS mining, installed alongside js-mine so a manual
# run in :kali / :terminal has them. Each name is VERIFIED to resolve, not assumed (kali-sandbox image
# trap), and docker/proof/jsrecon_install_proof.sh re-checks every name inside the running container.
#   * LinkFinder / SecretFinder — Python, isolated venv + PATH wrapper (the jwt_tool idiom).
#   * gitleaks — release binary (like trufflehog): no Go toolchain here, fetched from the latest tag.
#   * sourcemapper — Go; the reconFTW toolchain is long gone, so a THROWAWAY latest-Go is fetched to
#     build it (the wcvs pattern), then removed so only the binary ships.
RUN set -eu; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    git clone --depth 1 https://github.com/GerbenJavado/LinkFinder /opt/LinkFinder; \
        python3 -m venv /opt/LinkFinder/venv; \
        /opt/LinkFinder/venv/bin/pip install --no-cache-dir -q -r /opt/LinkFinder/requirements.txt || true; \
        /opt/LinkFinder/venv/bin/pip install --no-cache-dir -q jsbeautifier; \
        wrap LinkFinder "/opt/LinkFinder/venv/bin/python /opt/LinkFinder/linkfinder.py"; \
    git clone --depth 1 https://github.com/m4ll0k/SecretFinder /opt/SecretFinder; \
        python3 -m venv /opt/SecretFinder/venv; \
        /opt/SecretFinder/venv/bin/pip install --no-cache-dir -q jsbeautifier requests requests_file lxml || true; \
        wrap SecretFinder "/opt/SecretFinder/venv/bin/python /opt/SecretFinder/SecretFinder.py"; \
    chmod -R a+rX /opt/LinkFinder /opt/SecretFinder; \
    for b in LinkFinder SecretFinder; do command -v "$b" >/dev/null || { echo "MISSING js tool: $b"; exit 1; }; done
# gitleaks — latest release binary (no Go here).
RUN set -eu; \
    GL_TAG="$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest \
        | grep -oP '\"tag_name\":\s*\"\K[^\"]+')"; \
    [ -n "$GL_TAG" ] || { echo "gitleaks: could not resolve the latest tag"; exit 1; }; \
    GL_VER="${GL_TAG#v}"; \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/${GL_TAG}/gitleaks_${GL_VER}_linux_x64.tar.gz" \
        -o /tmp/gitleaks.tgz; \
    tar -C /usr/local/bin -xzf /tmp/gitleaks.tgz gitleaks; \
    rm /tmp/gitleaks.tgz; \
    chmod 0755 /usr/local/bin/gitleaks; \
    command -v gitleaks >/dev/null; \
    gitleaks version >/dev/null 2>&1 || gitleaks --version >/dev/null 2>&1
# sourcemapper — Go, throwaway toolchain (the wcvs pattern).
RUN set -eu; \
    GO_VER="$(curl -fsSL https://go.dev/VERSION?m=text | head -1)"; \
    [ -n "$GO_VER" ] || { echo "sourcemapper: could not resolve the latest Go version"; exit 1; }; \
    curl -fsSL "https://go.dev/dl/${GO_VER}.linux-amd64.tar.gz" -o /tmp/smgo.tgz; \
    mkdir -p /opt/sm-go; tar -C /opt/sm-go -xzf /tmp/smgo.tgz; rm /tmp/smgo.tgz; \
    export PATH="/opt/sm-go/go/bin:$PATH" GOBIN=/usr/local/bin GOFLAGS=-buildvcs=false GOTOOLCHAIN=auto; \
    go install github.com/denandz/sourcemapper@latest; \
    rm -rf /opt/sm-go /root/go /root/.cache/go-build; \
    command -v sourcemapper >/dev/null; \
    sourcemapper -h >/dev/null 2>&1 || sourcemapper --help >/dev/null 2>&1 || true

# --- 10. Strip file capabilities (REQUIRED — do not remove) -------------------
# Kali ships a few binaries with FILE capabilities so unprivileged desktop users get raw
# sockets: /usr/lib/nmap/nmap (cap_net_raw,cap_net_admin,cap_net_bind_service) and
# /usr/bin/fping (cap_net_raw). Every HackPit sandbox runs with
# `security_opt: no-new-privileges:true`, and no_new_privs makes the kernel REFUSE to exec
# any file that would grant privileges — so those binaries fail outright with
# "Operation not permitted". That breaks nmap in ALL THREE containers, not just the
# unprivileged ones.
#
# Stripping the file caps is the fix that costs nothing:
#   * engagement sandbox — runs as root WITH NET_RAW/NET_ADMIN as process capabilities, so
#     `nmap -sS` works from the process's own caps; it never needed the file caps.
#   * lab / :kali sandboxes — cap_drop: ALL means the bounding set would have masked the
#     file caps to nothing anyway. They degrade to `-sT`, exactly as on the old image.
# The alternative (dropping no-new-privileges) would weaken every sandbox to fix one tool.
# (-n1: `setcap` takes caps/file PAIRS, so it must be one file per invocation.)
RUN getcap -r /usr /bin /sbin /opt 2>/dev/null | awk '{print $1}' | xargs -r -n1 setcap -r \
    && test -z "$(getcap -r /usr /bin /sbin /opt 2>/dev/null)"

# --- 11. Users ----------------------------------------------------------------
# The image's DEFAULT user is unprivileged. The lab and `:kali` sandboxes run as this
# user with cap_drop: ALL. The ENGAGEMENT sandbox overrides it with `user: root` plus
# NET_RAW/NET_ADMIN in docker-compose.yml — that override is the one place root is
# granted, and it is granted only there.
# (Note: Debian/Kali ship a built-in `operator` system user, so we use our own name.)
#
# WORKDIR is /home/sandbox, and useradd creates it mode 700. On the engagement sandbox the
# process is root but holds ONLY NET_RAW/NET_ADMIN — no CAP_DAC_OVERRIDE — so a 700 directory
# owned by someone else is genuinely unreadable to it and tools that chdir (find, git, msf)
# fail there. 0755 makes the shared working directory usable by both users.
# ZAP writes its session/config state to $HOME/.ZAP and REFUSES TO START if that path is not
# writable, so both users get one here — created at build time rather than discovered at
# runtime as a scan that dies instantly. Same shape as the nuclei $HOME/.local case above; it
# belongs in THIS layer and not the ZAP install layer, because `sandbox` does not exist until
# the useradd on the first line below.
RUN useradd -m -s /bin/bash sandbox \
    && chmod 0755 /home/sandbox \
    && mkdir -p /root/.local /home/sandbox/.local /home/sandbox/.config \
                /root/.ZAP /home/sandbox/.ZAP \
    && ln -s /usr/share/nuclei-templates /root/.local/nuclei-templates \
    && ln -s /usr/share/nuclei-templates /home/sandbox/.local/nuclei-templates \
    && ln -sfn /usr/share/gf-patterns /home/sandbox/.gf \
    && chown -h sandbox:sandbox /home/sandbox/.gf \
    && chown -R sandbox:sandbox /home/sandbox/.local /home/sandbox/.config /home/sandbox/.ZAP

# A tiny baked wordlist kept from the pre-Kali image so any command still referencing it
# keeps working. For real work use /usr/share/seclists.
RUN printf '%s\n' \
        admin login rest api ftp backup users user products search \
        administration metrics robots.txt .git .env assets public \
        > /usr/share/hackpit-wordlist.txt

USER sandbox
WORKDIR /home/sandbox

# Stay alive so the backend can `docker exec` into it on demand.
CMD ["sleep", "infinity"]
