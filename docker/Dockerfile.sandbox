# HackPit Cockpit — Kali sandbox image.
#
# ONE image, three containers (see docker-compose.yml). The image is identical for the
# lab, `:kali` and engagement sandboxes — what differs is the RUNTIME posture each
# compose service applies (network, user, capabilities). Do not fork this file per
# sandbox; change the compose service instead.
#
# Tools are baked in at BUILD time (the build has internet). At RUNTIME the *lab*
# sandbox joins only the `internal: true` network, so it has no egress — it can never
# apt-install or phone home once running. That is the point, and it is why every tool
# and every wordlist has to be present in the image rather than fetched on demand.
#
# Base: kali-rolling + `kali-linux-headless`. The previous debian:stable-slim base shipped
# 7 tools while backend/arsenal/tools.json catalogued 73 — the planner routinely proposed
# commands (gobuster, nikto, impacket, netexec, …) that did not exist in the sandbox.
# Everything below exists to close that gap:
#   * kali-linux-headless      — the standard Kali CLI toolset
#   * explicit tool layers     — the specific tools the capability assessment found missing,
#                                grouped by theme so a bad package name fails in an obvious
#                                layer and the expensive layers above it stay cached
#   * seclists + wordlists     — real content discovery (the old image had a 15-word list)
#   * nuclei-templates         — baked; the lab sandbox has no egress so it can NEVER
#                                `-update-templates` at runtime
#
# NOT here, on purpose: PowerShell/.NET tooling (PowerView, Rubeus, Mimikatz, SharpHound,
# winPEAS). They cannot run on a Linux container. See D9 in docs/ASSESSMENT-2026-07-26.md.
#
# Size/time: this is a ~8-10 GB image and a cold build takes a while (kali-linux-headless
# and seclists are most of it). That is the agreed trade for a sandbox that can actually
# run what the arsenal advertises.
FROM kalilinux/kali-rolling

# Kali's apt prompts on a few packages (wireshark, kismet, sslh); never let a build block.
ENV DEBIAN_FRONTEND=noninteractive

# --- 1. The Kali toolset ------------------------------------------------------
# Slowest and most stable layer, so it goes first and stays cached across edits below.
# Recommends are deliberately NOT disabled here: several kali-tools-* metapackages pull
# their tools via Recommends, and stripping them would silently shrink the toolset.
RUN apt-get update \
    && apt-get install -y kali-linux-headless \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Shell + fetch + build basics -----------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl wget git \
        unzip p7zip-full \
        jq less vim tmux screen rlwrap \
        iproute2 iptables iputils-ping dnsutils \
        openssh-client \
        python3-pip python3-venv pipx \
    && rm -rf /var/lib/apt/lists/*

# --- 3. Web / recon ----------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nmap sqlmap nikto whatweb wafw00f wpscan \
        gobuster feroxbuster dirsearch wfuzz \
        subfinder httpx-toolkit amass \
        dnsrecon dnsenum fierce \
        sslscan testssl.sh \
        assetfinder dnsx naabu hakrawler arjun paramspider \
    && rm -rf /var/lib/apt/lists/*

# --- 3b. Web application scanner (ZAP) ---------------------------------------
# OWASP ZAP + a headless JRE. Its own layer because it is large and stable: an edit to the
# tool layers around it must not force it to rebuild.
#
# Add-ons are baked at build time on purpose. The lab sandbox joins an `internal: true`
# network and has NO egress, so it can never fetch one at runtime — the same reason
# nuclei-templates is baked in layer 9 rather than `-update-templates`d.
#
# THE SMOKE TEST IS THREE CHECKS, NOT ONE, because they fail separately. The package can
# install while shipping the scan scripts under a different name or leaving them off PATH,
# and that mismatch is INVISIBLE until a live run ingests nothing: backend/state/parsers.py
# keys STDOUT_PARSERS on `zap-baseline.py` / `zap-full-scan.py` exactly, and a key that never
# matches is the build #9 ingest gap (a live DCSync dumped krbtgt and ingested none of it).
# `command -v` alone is NOT a smoke test (build #4's lesson) — `zap.sh -version` is the check
# that proves the JVM actually starts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        zaproxy default-jre-headless \
    && rm -rf /var/lib/apt/lists/* \
    && zap.sh -version \
    && command -v zap-baseline.py \
    && command -v zap-full-scan.py

# --- 4. Network / Active Directory (from Linux) ------------------------------
# The AD graph + AD orchestration modules generate commands from exactly this set;
# without these packages every proposed AD step failed "executable not found".
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        smbclient smbmap enum4linux enum4linux-ng \
        python3-impacket impacket-scripts \
        netexec evil-winrm \
        bloodhound.py certipy-ad bloodyad \
        krb5-user ldap-utils \
        responder mitm6 \
        masscan arp-scan nbtscan onesixtyone snmp tcpdump \
    && rm -rf /var/lib/apt/lists/*

# --- 5. Exploitation / cracking ----------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        metasploit-framework exploitdb \
        hydra john hashcat \
        gdb trivy \
    && rm -rf /var/lib/apt/lists/*

# --- 6. Pivoting / tunnelling / VPN ------------------------------------------
# openvpn is here for HTB/PG/client VPNs. It also needs NET_ADMIN + /dev/net/tun, which
# only the ENGAGEMENT sandbox gets (docker-compose.yml). The lab sandbox has neither and
# must not — its whole value is that it cannot reach anything but the lab target.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chisel ligolo-ng proxychains4 sshuttle \
        socat ncat netcat-traditional \
        openvpn \
    && rm -rf /var/lib/apt/lists/*

# --- 7. Wordlists -------------------------------------------------------------
# seclists lands in /usr/share/seclists; `wordlists` provides /usr/share/wordlists
# (including rockyou, which it ships gzipped — decompress it at build so the no-egress
# sandbox can use it directly).
RUN apt-get update \
    && apt-get install -y --no-install-recommends seclists wordlists \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /usr/share/wordlists/rockyou.txt.gz ]; then \
           gunzip -f /usr/share/wordlists/rockyou.txt.gz; \
       fi \
    && test -d /usr/share/seclists

# --- 8. Pinned binaries -------------------------------------------------------
# Two reasons a tool lands here rather than in an apt layer above:
#   1. ffuf / nuclei — pinned deliberately rather than tracking kali-rolling; nuclei in
#      particular has to stay version-matched to the template set baked in layer 9.
#   2. katana / kerbrute / waybackurls — kali-rolling has NO package for these (verified
#      against the repo, not assumed), so upstream release binaries are the only option.
# /usr/local/bin precedes /usr/bin on PATH, so these win over any apt-installed copy.
# Every fetch ends in a `-version`/`-h` smoke test so a bad URL fails the build loudly
# instead of shipping an image that is missing a tool the arsenal advertises.
ARG FFUF_VERSION=2.1.0
RUN curl -fsSL "https://github.com/ffuf/ffuf/releases/download/v${FFUF_VERSION}/ffuf_${FFUF_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/ffuf.tgz \
    && tar -xzf /tmp/ffuf.tgz -C /usr/local/bin ffuf \
    && rm /tmp/ffuf.tgz \
    && /usr/local/bin/ffuf -V

ARG NUCLEI_VERSION=3.3.9
RUN curl -fsSL "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip" \
        -o /tmp/nuclei.zip \
    && unzip -o /tmp/nuclei.zip nuclei -d /usr/local/bin \
    && rm /tmp/nuclei.zip \
    && /usr/local/bin/nuclei -version

# katana — crawler. Not in kali-rolling.
ARG KATANA_VERSION=1.1.0
RUN curl -fsSL "https://github.com/projectdiscovery/katana/releases/download/v${KATANA_VERSION}/katana_${KATANA_VERSION}_linux_amd64.zip" \
        -o /tmp/katana.zip \
    && unzip -o /tmp/katana.zip katana -d /usr/local/bin \
    && rm /tmp/katana.zip \
    && /usr/local/bin/katana -version

# kerbrute — Kerberos user/password enumeration. Not in kali-rolling.
ARG KERBRUTE_VERSION=1.0.3
RUN curl -fsSL "https://github.com/ropnop/kerbrute/releases/download/v${KERBRUTE_VERSION}/kerbrute_linux_amd64" \
        -o /usr/local/bin/kerbrute \
    && chmod +x /usr/local/bin/kerbrute \
    && /usr/local/bin/kerbrute --help > /dev/null

# waybackurls — archived-URL discovery for bug bounty. Not in kali-rolling.
ARG WAYBACKURLS_VERSION=0.1.0
RUN curl -fsSL "https://github.com/tomnomnom/waybackurls/releases/download/v${WAYBACKURLS_VERSION}/waybackurls-linux-amd64-${WAYBACKURLS_VERSION}.tgz" \
        -o /tmp/waybackurls.tgz \
    && tar -xzf /tmp/waybackurls.tgz -C /usr/local/bin waybackurls \
    && rm /tmp/waybackurls.tgz \
    && test -x /usr/local/bin/waybackurls

# dalfox — XSS scanner. Not in kali-rolling.
ARG DALFOX_VERSION=2.9.2
RUN curl -fsSL "https://github.com/hahwul/dalfox/releases/download/v${DALFOX_VERSION}/dalfox_${DALFOX_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/dalfox.tgz \
    && tar -xzf /tmp/dalfox.tgz -C /usr/local/bin dalfox \
    && rm /tmp/dalfox.tgz \
    && /usr/local/bin/dalfox version

# gau (getallurls) — archived-URL discovery. Not in kali-rolling.
ARG GAU_VERSION=2.2.4
RUN curl -fsSL "https://github.com/lc/gau/releases/download/v${GAU_VERSION}/gau_${GAU_VERSION}_linux_amd64.tar.gz" \
        -o /tmp/gau.tgz \
    && tar -xzf /tmp/gau.tgz -C /usr/local/bin gau \
    && rm /tmp/gau.tgz \
    && test -x /usr/local/bin/gau

# rustscan — fast port sweep that hands off to nmap. Not in kali-rolling. Upstream ships
# the linux build as a .tar.gz INSIDE a .zip, hence the two-step extract.
ARG RUSTSCAN_VERSION=2.4.1
RUN curl -fsSL "https://github.com/bee-san/RustScan/releases/download/${RUSTSCAN_VERSION}/x86_64-linux-rustscan.tar.gz.zip" \
        -o /tmp/rustscan.zip \
    && unzip -o -j /tmp/rustscan.zip -d /tmp/rustscan \
    && tar -xzf "$(find /tmp/rustscan -name '*.tar.gz' | head -1)" -C /tmp/rustscan \
    && install -m 0755 "$(find /tmp/rustscan -type f -name 'rustscan' | head -1)" /usr/local/bin/rustscan \
    && rm -rf /tmp/rustscan /tmp/rustscan.zip \
    && /usr/local/bin/rustscan --version

# jwt_tool — JWT analysis/forging. A Python script, not a binary and not packaged; it gets
# its own venv so its pins never collide with Kali's system Python (which is PEP-668
# externally-managed), plus a wrapper so `jwt_tool` resolves on PATH like any other tool.
ARG JWT_TOOL_VERSION=2.2.6
RUN curl -fsSL "https://github.com/ticarpi/jwt_tool/archive/refs/tags/v${JWT_TOOL_VERSION}.tar.gz" \
        -o /tmp/jwt_tool.tgz \
    && mkdir -p /opt/jwt_tool \
    && tar -xzf /tmp/jwt_tool.tgz -C /opt/jwt_tool --strip-components=1 \
    && rm /tmp/jwt_tool.tgz \
    && python3 -m venv /opt/jwt_tool/venv \
    && /opt/jwt_tool/venv/bin/pip install --no-cache-dir -q -r /opt/jwt_tool/requirements.txt \
    && printf '#!/bin/sh\nexec /opt/jwt_tool/venv/bin/python /opt/jwt_tool/jwt_tool.py "$@"\n' \
        > /usr/local/bin/jwt_tool \
    && chmod 0755 /usr/local/bin/jwt_tool \
    && chmod -R a+rX /opt/jwt_tool \
    && /usr/local/bin/jwt_tool --help > /dev/null

# --- 9. nuclei templates (baked — the sandbox can never fetch them) ----------
# Cloned to a shared path, then symlinked into BOTH possible home directories, because
# nuclei looks in $HOME/.local/nuclei-templates and the engagement sandbox runs as root
# while the lab/:kali sandboxes run as `sandbox`. Symlinks rather than config files so
# this does not depend on nuclei's config-key naming staying stable.
# Pin NUCLEI_TEMPLATES_REF to a tag for a fully reproducible build.
ARG NUCLEI_TEMPLATES_REF=main
RUN git clone --depth 1 --branch "${NUCLEI_TEMPLATES_REF}" \
        https://github.com/projectdiscovery/nuclei-templates.git \
        /usr/share/nuclei-templates \
    && rm -rf /usr/share/nuclei-templates/.git \
    && test "$(find /usr/share/nuclei-templates -name '*.yaml' | head -1001 | wc -l)" -gt 1000

# Suppress nuclei's startup update check — it has no egress at runtime and the warning
# only adds noise to every transcript.
ENV DISABLE_UPDATE_CHECK=true

# --- 9b. Catalog-name aliases -------------------------------------------------
# Three tools install under a binary name that differs from the name
# backend/arsenal/tools.json calls them by. Without these, the startup reconciliation
# check (D7) reports installed tools as missing and the planner's prompt block silently
# loses them — the exact failure mode this whole image rebuild exists to end.
#   arsenal name  ->  Kali binary
#   testssl.sh        testssl
#   certipy           certipy-ad
#   bloodyAD          bloodyad
# The `test -x` guards mean a future Kali rename breaks the BUILD rather than quietly
# reintroducing a dangling alias.
RUN set -e; \
    for pair in "testssl.sh:testssl" "certipy:certipy-ad" "bloodyAD:bloodyad"; do \
        alias_name="${pair%%:*}"; real="${pair#*:}"; \
        target="$(command -v "$real")"; \
        test -x "$target"; \
        ln -sfn "$target" "/usr/local/bin/${alias_name}"; \
    done; \
    for n in testssl.sh certipy bloodyAD; do command -v "$n" >/dev/null; done

# --- 9c. reconFTW recon tools — apt (kali packages) --------------------------
# massdns (the resolver engine puredns drives) and commix are both in kali-rolling.
# Placed below the expensive kali/seclists/nuclei layers so editing the recon set never
# invalidates their cache.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        massdns commix \
    && rm -rf /var/lib/apt/lists/* \
    && command -v massdns && command -v commix >/dev/null

# --- 9d. reconFTW recon tools — Go (built with a temporary toolchain) ---------
# No kali package for these (checked against reconFTW's own install list). Rather than guess
# ~18 release-asset URLs, build them with `go install` using the exact module paths from
# reconFTW's install.sh, into /usr/local/bin. The Go toolchain + build cache are removed at
# the end of the layer so only the binaries ship. @latest matches reconFTW; pin a tag for a
# fully reproducible build. Every binary is smoke-checked so a bad module fails the build.
ARG GO_VERSION=1.23.4
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz \
    && export PATH="/usr/local/go/bin:$PATH" GOBIN=/usr/local/bin GOFLAGS=-buildvcs=false \
    && for mod in \
        github.com/tomnomnom/gf@latest \
        github.com/tomnomnom/qsreplace@latest \
        github.com/tomnomnom/unfurl@latest \
        github.com/lc/subjs@latest \
        github.com/BishopFox/jsluice/cmd/jsluice@latest \
        github.com/dwisiswant0/crlfuzz/cmd/crlfuzz@latest \
        github.com/d3mondev/puredns/v2@latest \
        github.com/Josue87/gotator@latest \
        github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest \
        github.com/projectdiscovery/asnmap/cmd/asnmap@latest \
        github.com/projectdiscovery/tlsx/cmd/tlsx@latest \
        github.com/gwen001/github-subdomains@latest \
        github.com/gwen001/gitlab-subdomains@latest \
        github.com/damit5/gitdorks_go@latest \
        github.com/sa7mon/s3scanner@latest \
        github.com/edoardottt/csprecon/cmd/csprecon@latest \
        github.com/devploit/nomore403@latest \
    ; do echo ">> go install $mod" && go install "$mod"; done \
    # getjs overlaps subjs and its module path is less stable — best-effort, never fails the build.
    && { go install github.com/003random/getJS/v2@latest \
         && ln -sfn "$(command -v getJS)" /usr/local/bin/getjs; } || echo "getjs: optional, skipped" \
    && rm -rf /usr/local/go /root/go /root/.cache/go-build \
    && for b in gf qsreplace unfurl subjs jsluice crlfuzz puredns gotator mapcidr asnmap tlsx \
                github-subdomains gitlab-subdomains gitdorks_go s3scanner csprecon nomore403; do \
           command -v "$b" >/dev/null || { echo "MISSING go tool: $b"; exit 1; }; \
       done

# --- 9d-bis. trufflehog (release binary, not `go install`) -------------------
# trufflehog's recent releases require Go >= 1.25, a moving target that broke the pinned Go
# toolchain above. Its official installer fetches the prebuilt linux/amd64 binary instead —
# no toolchain, no version treadmill. Smoke-tested so a bad fetch still fails the build.
RUN curl -fsSL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh \
        | sh -s -- -b /usr/local/bin \
    && /usr/local/bin/trufflehog --version 2>&1 | head -1 \
    && command -v trufflehog >/dev/null

# --- 9e. reconFTW recon tools — Python (venv + PATH wrapper) ------------------
# No kali package; each gets an isolated venv (Kali's system Python is PEP-668 managed) and a
# PATH wrapper, the jwt_tool idiom. subwiz is deliberately NOT here: it downloads an ML model
# at runtime, so it is catalogued but runs only in the egress-enabled sandboxes
# (engagement / :kali), never the airgapped lab — gotator/regulator cover permutations offline.
RUN set -eu; \
    mkvenv() { git clone --depth 1 "https://github.com/$1" "/opt/$2"; \
               python3 -m venv "/opt/$2/venv"; \
               if [ -f "/opt/$2/requirements.txt" ]; then \
                   "/opt/$2/venv/bin/pip" install --no-cache-dir -q -r "/opt/$2/requirements.txt"; fi; }; \
    wrap() { printf '#!/bin/sh\nexec %s "$@"\n' "$2" > "/usr/local/bin/$1"; chmod 0755 "/usr/local/bin/$1"; }; \
    mkvenv cramppet/regulator regulator; \
        wrap regulator "/opt/regulator/venv/bin/python /opt/regulator/main.py"; \
    mkvenv vladko312/SSTImap SSTImap; \
        wrap SSTImap "/opt/SSTImap/venv/bin/python /opt/SSTImap/sstimap.py"; \
    mkvenv six2dez/dorks_hunter dorks_hunter; \
        "/opt/dorks_hunter/venv/bin/pip" install --no-cache-dir -q xnldorker || true; \
        wrap dorks_hunter "/opt/dorks_hunter/venv/bin/python /opt/dorks_hunter/dorks_hunter.py"; \
    mkvenv initstring/cloud_enum cloud_enum; \
        wrap cloud_enum "/opt/cloud_enum/venv/bin/python /opt/cloud_enum/cloud_enum.py"; \
    git clone --depth 1 https://github.com/vortexau/dnsvalidator /opt/dnsvalidator; \
        python3 -m venv /opt/dnsvalidator/venv; \
        /opt/dnsvalidator/venv/bin/pip install --no-cache-dir -q /opt/dnsvalidator; \
        wrap dnsvalidator "/opt/dnsvalidator/venv/bin/dnsvalidator"; \
    git clone --depth 1 https://github.com/Arcanum-Sec/msftrecon /opt/msftrecon; \
        python3 -m venv /opt/msftrecon/venv; \
        /opt/msftrecon/venv/bin/pip install --no-cache-dir -q -e /opt/msftrecon; \
        wrap msftrecon "/opt/msftrecon/venv/bin/msftrecon"; \
    chmod -R a+rX /opt/regulator /opt/SSTImap /opt/dorks_hunter /opt/cloud_enum /opt/dnsvalidator /opt/msftrecon; \
    for b in regulator SSTImap dorks_hunter cloud_enum dnsvalidator msftrecon; do command -v "$b" >/dev/null; done

# --- 9f. gf pattern packs + a static resolver list (baked — no runtime egress) ---
# gf is inert without pattern packs; the lab has no egress so they must be present in the
# image. Merge 1ndianl33t/Gf-Patterns with tomnomnom/gf's own examples into a shared dir and
# symlink it as root's ~/.gf (the sandbox user's ~/.gf is symlinked in the users layer below).
# The resolver list is the offline default for puredns/massdns; dnsvalidator refreshes it only
# where there is egress (engagement / :kali).
RUN git clone --depth 1 https://github.com/1ndianl33t/Gf-Patterns /tmp/gfp \
    && git clone --depth 1 https://github.com/tomnomnom/gf /tmp/gf \
    && mkdir -p /usr/share/gf-patterns \
    && cp /tmp/gfp/*.json /usr/share/gf-patterns/ \
    && cp /tmp/gf/examples/*.json /usr/share/gf-patterns/ 2>/dev/null || true \
    && rm -rf /tmp/gfp /tmp/gf \
    && ln -sfn /usr/share/gf-patterns /root/.gf \
    && test -n "$(ls /usr/share/gf-patterns/*.json 2>/dev/null)" \
    && { curl -fsSL https://raw.githubusercontent.com/trickest/resolvers/main/resolvers.txt \
            -o /usr/share/resolvers.txt \
         || printf '%s\n' 1.1.1.1 8.8.8.8 8.8.4.4 9.9.9.9 1.0.0.1 208.67.222.222 208.67.220.220 \
            > /usr/share/resolvers.txt; } \
    && test -s /usr/share/resolvers.txt

# --- 9b. C2 + evasion (build #4) ----------------------------------------------
# Everything here was probed against THIS image's kali-rolling snapshot before being written,
# because three of the five tools are not packaged and one is already installed:
#   * dnscat2   — NOT in kali-rolling (verified with apt-cache policy, not assumed). Built from
#                 source: the client is C (make) and the server is Ruby, and both gcc/make and
#                 ruby are already in the image. Installed under the HYPHENATED names the
#                 arsenal catalog advertises, so the catalog and the image agree.
#   * iodine    — ALREADY PRESENT from the Kali toolset layer at /usr/sbin/iodine(d).
#                 Nothing to install; it is only smoke-tested below so a future base-image
#                 change that drops it fails the build instead of shipping a broken catalog.
#   * sliver    — NOT packaged, and there is NO Go toolchain in this image (deliberately: the
#                 Go layer is not kept). Official release binaries are the only option, which
#                 also dodges the Go-version floor that a `go install` would impose.
#   * donut     — no apt candidate and no py3.13 wheel, only a source tarball; it is a C
#                 extension and gcc is present, so it builds. Own venv per this file's
#                 convention (PEP 668 makes system pip a non-starter on Kali anyway).
#   * ScareCrow — NOT packaged; release binary. Its signing step shells out to osslsigncode,
#                 which IS available (2.13-2) and is installed alongside it as a HARD
#                 requirement (no `|| true`) — the consolidated smoke test asserts it runs.
#                 Note the release asset is tagged v5.1 and named
#                 ScareCrow_5.1_linux_amd64 — there is no 5.1.x asset; a guessed patch
#                 version 404s and fails this layer.
#
# SMOKE TESTS MUST CARRY A STATUS. Every step ends in a smoke test so a bad URL or a moved
# release fails the build loudly — but `tool -h | head -1` does NOT do that: the exit status of
# a pipeline is the LAST command's, so `head` returns 0 even when the tool is missing, empty or
# dies on its first line. `|| true` is the same failure with the intent written down. Every
# invocation below therefore ends in `grep -q`, which fails when the tool produces no output.
# Regression-locked in backend/test_evasion.py.

# Sliver — release binaries (server + client).
ARG SLIVER_VERSION=1.5.42
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/sliver-server \
        "https://github.com/BishopFox/sliver/releases/download/v${SLIVER_VERSION}/sliver-server_linux"; \
    curl -fsSL -o /usr/local/bin/sliver-client \
        "https://github.com/BishopFox/sliver/releases/download/v${SLIVER_VERSION}/sliver-client_linux"; \
    chmod 0755 /usr/local/bin/sliver-server /usr/local/bin/sliver-client; \
    /usr/local/bin/sliver-server version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    /usr/local/bin/sliver-client version 2>&1 | grep -q "v${SLIVER_VERSION}"

# dnscat2 — DNS-tunnelled channel. Client compiled from source; server is the shipped Ruby.
# Wrapped as dnscat2-server / dnscat2-client to match backend/arsenal/tools.json.
# The server's four gems (trollop/salsa20/sha3/ecdsa, per its own Gemfile) are NOT optional —
# without them dnscat2.rb dies on `require 'ecdsa'`. dnscat2.rb has no --help of its own, so
# the gems are asserted DIRECTLY below; a missing gem fails the build rather than surfacing at
# engagement time.
# Pinned by docker/pin-build4-versions.sh: dnscat2 has no release tags, so the client is
# built from a fixed commit, and the four gems plus donut-shellcode carry exact versions.
# Re-run that script to move the pins forward.
ARG DNSCAT2_COMMIT=42f8d783488836c0e24ff25571684170be0a0cc2
RUN set -eux; \
    git clone https://github.com/iagox86/dnscat2.git /opt/dnscat2; \
    git -C /opt/dnscat2 checkout --detach "${DNSCAT2_COMMIT}"; \
    make -C /opt/dnscat2/client; \
    install -m 0755 /opt/dnscat2/client/dnscat /usr/local/bin/dnscat2-client; \
    gem install --no-document trollop:2.9.10 salsa20:0.1.3 sha3:2.2.4 ecdsa:1.2.0; \
    printf '%s\n' '#!/bin/sh' 'exec ruby /opt/dnscat2/server/dnscat2.rb "$@"' \
        > /usr/local/bin/dnscat2-server; \
    chmod 0755 /usr/local/bin/dnscat2-server; \
    /usr/local/bin/dnscat2-client --help 2>&1 | grep -qi dnscat; \
    ruby -e "require 'ecdsa'; require 'salsa20'; require 'sha3'; require 'trollop'; puts 'dnscat2 server gems ok'"

# iodine — already installed by the Kali toolset layer; assert it, do not reinstall.
RUN set -eux; \
    command -v iodine; \
    command -v iodined; \
    iodine -h 2>&1 | grep -qi iodine

# donut — shellcode-from-PE generator, in its own venv (this file's convention).
# donut-shellcode is a C EXTENSION exposing exactly one callable, `donut.create(...)`. It has
# no console_script and no __main__, so `python -m donut` cannot work — the CLI below is ours,
# and its -i/-o/-a flags are what backend/arsenal/tools.json advertises.
RUN set -eux; \
    python3 -m venv /opt/donut/venv; \
    /opt/donut/venv/bin/pip install --no-cache-dir -q donut-shellcode==1.1; \
    /opt/donut/venv/bin/python -c "import donut; assert callable(donut.create)"; \
    printf '%s\n' \
        '#!/opt/donut/venv/bin/python' \
        '"""Minimal CLI over donut-shellcode (the module ships none)."""' \
        'import argparse, sys, donut' \
        'p = argparse.ArgumentParser(prog="donut", description="PE/.NET -> position-independent shellcode")' \
        'p.add_argument("-i", "--input", required=True, help="input .exe/.dll assembly")' \
        'p.add_argument("-o", "--output", default="loader.bin", help="output shellcode file")' \
        'p.add_argument("-a", "--arch", type=int, default=3, choices=(1, 2, 3), help="1=x86 2=amd64 3=both")' \
        'p.add_argument("-p", "--params", default="", help="parameters passed to the entry point")' \
        'a = p.parse_args()' \
        'n = donut.create(file=a.input, output=a.output, arch=a.arch, params=a.params or None)' \
        'if not n:' \
        '    sys.exit("donut: generation failed")' \
        'print(f"{n} bytes -> {a.output}")' \
        > /usr/local/bin/donut; \
    chmod 0755 /usr/local/bin/donut; \
    /usr/local/bin/donut --help >/dev/null

# ScareCrow — loader generator. Its signing step shells out to osslsigncode, which IS in this
# snapshot (2.13-2) and is a HARD requirement here: no `|| true`, so a snapshot that drops it
# fails this layer rather than shipping a ScareCrow whose signing path is broken.
ARG SCARECROW_VERSION=5.1
RUN set -eux; \
    apt-get update && apt-get install -y --no-install-recommends osslsigncode \
        && rm -rf /var/lib/apt/lists/*; \
    curl -fsSL -o /tmp/scarecrow \
        "https://github.com/optiv/ScareCrow/releases/download/v${SCARECROW_VERSION}/ScareCrow_${SCARECROW_VERSION}_linux_amd64"; \
    install -m 0755 /tmp/scarecrow /usr/local/bin/ScareCrow; \
    rm -f /tmp/scarecrow; \
    /usr/local/bin/ScareCrow -h 2>&1 | grep -qi scarecrow

# proxychains, pointed at the tunnel HackPit actually starts.
#
# Debian ships /etc/proxychains4.conf configured for Tor (`socks4 127.0.0.1 9050`). HackPit's
# chisel plan brings up a reverse SOCKS5 on THIS box at 127.0.0.1:1080 (cockpit/tunnels.py,
# CHISEL_SOCKS_PORT) and `wrap_command` rewrites a command to `proxychains -q …` on the strength
# of that — so with the stock config the rewritten command the operator approves would quietly
# try Tor and time out. Found by the live-fire run, which is exactly the class of gap a proof
# harness exists to find: every unit test passed, and the shipped path could not work.
#
# The Tor line is replaced rather than appended to: proxychains reads the LAST [ProxyList]
# section, and leaving 9050 in place makes the chain depend on ordering.
RUN set -eux; \
    sed -i 's|^socks4[[:space:]].*|socks5 127.0.0.1 1080|' /etc/proxychains4.conf; \
    grep -q '^socks5 127.0.0.1 1080' /etc/proxychains4.conf; \
    ! grep -q '^socks4' /etc/proxychains4.conf

# One consolidated smoke test: the build FAILS if any advertised binary is missing OR broken.
# A `command -v` check alone is not a smoke test — it passes for a binary that dies on its
# first line. Neither is `tool -h | head -1`: a pipeline's status is the LAST command's, so
# `head` returns 0 for a tool that never ran. And `|| true` discards the status outright —
# ScareCrow was checked that way, making it the one advertised binary whose brokenness could
# not fail this build. Every tool below is INVOKED and its OUTPUT asserted with `grep -q`,
# which fails on an empty or absent one. (dnscat2-server has no --help of its own, so its gems
# are asserted directly; ScareCrow exits non-zero on -h by design, which grep does not care
# about — grep sees the usage banner either way.)
#
# THE SLIVER PAIR MATCHES THE PINNED VERSION, NOT THE WORD "sliver" (build #7). Both were
# checked with `grep -qi sliver` — and `sliver-server version` prints exactly
# `v1.5.42 - <sha>`, which does not contain the string "sliver". That assertion could never
# pass, so this layer could never build; the image in the registry predates the check. The
# static test that guards this block (backend/test_evasion.py) reads the SHAPE of these lines
# — `|| true`, `| head` — and cannot know whether a grep pattern actually matches, so only a
# real build surfaced it. Matching "v${SLIVER_VERSION}" is strictly stronger than the name
# would have been: it fails when the binary is missing, dies, or is not the version pinned
# above.
RUN set -eux; \
    for b in sliver-server sliver-client dnscat2-server dnscat2-client iodine iodined donut ScareCrow; do \
        command -v "$b" >/dev/null || { echo "MISSING: $b"; exit 1; }; \
    done; \
    sliver-server version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    sliver-client version 2>&1 | grep -q "v${SLIVER_VERSION}"; \
    dnscat2-client --help 2>&1 | grep -qi dnscat; \
    ruby -e "require 'ecdsa'; require 'salsa20'; require 'sha3'; require 'trollop'"; \
    iodine -h 2>&1 | grep -qi iodine; \
    iodined -h 2>&1 | grep -qi iodine; \
    donut --help 2>&1 | grep -qi shellcode; \
    ScareCrow -h 2>&1 | grep -qi scarecrow; \
    osslsigncode --version >/dev/null; \
    echo "build #4 C2/evasion toolset present and each tool runs"

# --- 10. Strip file capabilities (REQUIRED — do not remove) -------------------
# Kali ships a few binaries with FILE capabilities so unprivileged desktop users get raw
# sockets: /usr/lib/nmap/nmap (cap_net_raw,cap_net_admin,cap_net_bind_service) and
# /usr/bin/fping (cap_net_raw). Every HackPit sandbox runs with
# `security_opt: no-new-privileges:true`, and no_new_privs makes the kernel REFUSE to exec
# any file that would grant privileges — so those binaries fail outright with
# "Operation not permitted". That breaks nmap in ALL THREE containers, not just the
# unprivileged ones.
#
# Stripping the file caps is the fix that costs nothing:
#   * engagement sandbox — runs as root WITH NET_RAW/NET_ADMIN as process capabilities, so
#     `nmap -sS` works from the process's own caps; it never needed the file caps.
#   * lab / :kali sandboxes — cap_drop: ALL means the bounding set would have masked the
#     file caps to nothing anyway. They degrade to `-sT`, exactly as on the old image.
# The alternative (dropping no-new-privileges) would weaken every sandbox to fix one tool.
# (-n1: `setcap` takes caps/file PAIRS, so it must be one file per invocation.)
RUN getcap -r /usr /bin /sbin /opt 2>/dev/null | awk '{print $1}' | xargs -r -n1 setcap -r \
    && test -z "$(getcap -r /usr /bin /sbin /opt 2>/dev/null)"

# --- 11. Users ----------------------------------------------------------------
# The image's DEFAULT user is unprivileged. The lab and `:kali` sandboxes run as this
# user with cap_drop: ALL. The ENGAGEMENT sandbox overrides it with `user: root` plus
# NET_RAW/NET_ADMIN in docker-compose.yml — that override is the one place root is
# granted, and it is granted only there.
# (Note: Debian/Kali ship a built-in `operator` system user, so we use our own name.)
#
# WORKDIR is /home/sandbox, and useradd creates it mode 700. On the engagement sandbox the
# process is root but holds ONLY NET_RAW/NET_ADMIN — no CAP_DAC_OVERRIDE — so a 700 directory
# owned by someone else is genuinely unreadable to it and tools that chdir (find, git, msf)
# fail there. 0755 makes the shared working directory usable by both users.
# ZAP writes its session/config state to $HOME/.ZAP and REFUSES TO START if that path is not
# writable, so both users get one here — created at build time rather than discovered at
# runtime as a scan that dies instantly. Same shape as the nuclei $HOME/.local case above; it
# belongs in THIS layer and not the ZAP install layer, because `sandbox` does not exist until
# the useradd on the first line below.
RUN useradd -m -s /bin/bash sandbox \
    && chmod 0755 /home/sandbox \
    && mkdir -p /root/.local /home/sandbox/.local /home/sandbox/.config \
                /root/.ZAP /home/sandbox/.ZAP \
    && ln -s /usr/share/nuclei-templates /root/.local/nuclei-templates \
    && ln -s /usr/share/nuclei-templates /home/sandbox/.local/nuclei-templates \
    && ln -sfn /usr/share/gf-patterns /home/sandbox/.gf \
    && chown -h sandbox:sandbox /home/sandbox/.gf \
    && chown -R sandbox:sandbox /home/sandbox/.local /home/sandbox/.config /home/sandbox/.ZAP

# A tiny baked wordlist kept from the pre-Kali image so any command still referencing it
# keeps working. For real work use /usr/share/seclists.
RUN printf '%s\n' \
        admin login rest api ftp backup users user products search \
        administration metrics robots.txt .git .env assets public \
        > /usr/share/hackpit-wordlist.txt

USER sandbox
WORKDIR /home/sandbox

# Stay alive so the backend can `docker exec` into it on demand.
CMD ["sleep", "infinity"]
